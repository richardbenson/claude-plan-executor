diff --git a/src/commands/update.ts b/src/commands/update.ts
new file mode 100644
index 0000000..d85a92b
--- /dev/null
+++ b/src/commands/update.ts
@@ -0,0 +1,105 @@
+import { CPE_VERSION } from '../version.js';
+import os from 'node:os';
+import fs from 'node:fs/promises';
+import { createWriteStream } from 'node:fs';
+import { pipeline } from 'node:stream/promises';
+
+const REPO = 'richardbenson/claude-plan-executor';
+const VERSION_API = `https://api.github.com/repos/${REPO}/releases/latest`;
+
+async function getLatestVersion(): Promise<{ version: string; url: string }> {
+  const response = await fetch(VERSION_API);
+  if (!response.ok) throw new Error(`GitHub API error: ${response.statusText}`);
+  const data = await response.json();
+  
+  const version = data.tag_name.startsWith('v') ? data.tag_name.slice(1) : data.tag_name;
+
+  const platform = os.platform(); 
+  const arch = os.arch();         
+
+  let osName = '';
+  if (platform === 'linux') osName = 'linux';
+  else if (platform === 'darwin') osName = 'darwin';
+  else throw new Error(`Unsupported platform: ${platform}`);
+
+  let archName = '';
+  if (arch === 'x64') archName = 'x64';
+  else if (arch === 'arm64') archName = 'arm64';
+  else throw new Error(`Unsupported architecture: ${arch}`);
+
+  const assetName = `cpe-${osName}-${archName}`;
+  const asset = data.assets.find((a: { name: string; browser_download_url: string }) => a.name === assetName);
+  if (!asset) throw new Error(`No binary found for platform ${osName}-${archName}`);
+
+  return { version, url: asset.browser_download_url };
+}
+
+export async function updateCommand(): Promise<void> {
+  try {
+    console.log('Checking for updates...');
+    const { version: latestVersion, url } = await getLatestVersion();
+
+    if (CPE_VERSION === 'dev' || CPE_VERSION !== latestVersion) {
+      console.log(`New version available: ${latestVersion} (current: ${CPE_VERSION})`);
+      
+      console.log('Downloading update...');
+      const response = await fetch(url);
+      if (!response.ok) throw new Error(`Failed to download binary: ${response.statusText}`);
+
+      const exePath = process.execPath;
+      const tempPath = `${exePath}.tmp`;
+
+      const fileStream = createWriteStream(tempPath);
+      await pipeline(response.body!, fileStream);
+
+      if (os.platform() !== 'win32') {
+        await fs.chmod(tempPath, 0o755);
+      }
+
+      await fs.rename(tempPath, exePath);
+      console.log(`Successfully updated to ${latestVersion}!`);
+    } else {
+      console.log('cpe is up to date.');
+    }
+  } catch (err) {
+    throw new Error(`Update failed: ${err instanceof Error ? err.message : String(err)}`);
+  }
+}
+
+export async function checkVersionCommand(): Promise<void> {
+  try {
+    console.log(`Current version: ${CPE_VERSION}`);
+    const { version: latestVersion } = await getLatestVersion();
+    if (CPE_VERSION === 'dev' || CPE_VERSION !== latestVersion) {
+      console.log(`Update available: ${latestVersion}. Run 'cpe update' to upgrade.`);
+    } else {
+      console.log('You are running the latest version.');
+    }
+  } catch (err) {
+    throw new Error(`Could not check version: ${err instanceof Error ? err.message : String(err)}`);
+  }
+}
+
+export async function autoUpdate(): Promise<{ updated: boolean; version: string }> {
+  try {
+    const { version: latestVersion, url } = await getLatestVersion();
+    if (CPE_VERSION === 'dev' || CPE_VERSION !== latestVersion) {
+      const response = await fetch(url);
+      if (!response.ok) return { updated: false, version: latestVersion };
+
+      const exePath = process.execPath;
+      const tempPath = `${exePath}.tmp`;
+      const fileStream = createWriteStream(tempPath);
+      await pipeline(response.body!, fileStream);
+
+      if (os.platform() !== 'win32') {
+        await fs.chmod(tempPath, 0o755);
+      }
+      await fs.rename(tempPath, exePath);
+      return { updated: true, version: latestVersion };
+    }
+  } catch {
+    // Silent fail for auto-update to avoid disrupting user experience
+  }
+  return { updated: false, version: CPE_VERSION };
+}
