@@ -0,0 +1,41 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import * as os from 'os';
+
+const DEFAULT_STATE_BASE = path.join(os.homedir(), '.local', 'state', 'cpe');
+
+export interface UpdateState {
+  last_checked_at?: string;
+  latest_seen?: string;
+}
+
+function getStatePath(base?: string): string {
+  return path.join(base ?? DEFAULT_STATE_BASE, 'update-check.json');
+}
+
+export function readUpdateState(base?: string): UpdateState | null {
+  const p = getStatePath(base);
+  try {
+    if (!fs.existsSync(p)) return null;
+    return JSON.parse(fs.readFileSync(p, 'utf8')) as UpdateState;
+  } catch {
+    return null; // Treat corrupt or unreadable as null (trigger check)
+  }
+}
+
+export function writeUpdateState(state: UpdateState, base?: string): void {
+  const p = getStatePath(base);
+  fs.mkdirSync(path.dirname(p), { recursive: true });
+  fs.writeFileSync(p, JSON.stringify(state, null, 2) + '\n');
+}
+
+export function shouldCheck(intervalHours: number, now?: Date, base?: string): boolean {
+  const state = readUpdateState(base);
+  if (!state || !state.last_checked_at) return true;
+
+  const lastChecked = new Date(state.last_checked_at);
+  const currentTime = now ?? new Date();
+  
+  const diffMs = currentTime.getTime() - lastChecked.getTime();
+  return diffMs > intervalHours * 60 * 60 * 1000;
+}
