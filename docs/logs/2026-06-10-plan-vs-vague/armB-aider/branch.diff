@@ -0,0 +1,94 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import { Buffer } from 'buffer';
+
+/**
+ * Maps platform and arch to the expected asset name.
+ */
+export function getAssetName(platform: string, arch: string): string {
+  const osMap: Record<string, string> = { linux: 'linux', darwin: 'darwin' };
+  const archMap: Record<string, string> = { x64: 'x64', arm64: 'arm64' };
+
+  const os = osMap[platform.toLowerCase()];
+  const archStr = archMap[arch.toLowerCase()];
+
+  if (!os || !archStr) {
+    throw new Error(`Unsupported platform/architecture combination: ${platform}-${arch}`);
+  }
+
+  return `cpe-${os}-${archStr}`;
+}
+
+/**
+ * Downloads and installs a new binary version atomically.
+ */
+export async function downloadAndInstall(
+  tag: string, 
+  opts?: { execPath?: string; fetchImpl?: typeof fetch }
+): Promise<void> {
+  const execPath = opts?.execPath ?? process.execPath;
+  const fetchImpl = opts?.fetchImpl ?? fetch;
+  const targetDir = path.dirname(execPath);
+
+  // 1. Determine asset name
+  const assetName = getAssetName(process.platform, process.arch);
+  const sumsUrl = `https://github.com/richardbenson/claude-plan-executor/releases/download/${tag}/SHA256SUMS`;
+  const assetUrl = `https://github.com/richardbenson/claude-plan-executor/releases/download/${tag}/${assetName}`;
+
+  // 2. Download SHA256SUMS
+  let sumsContent: string;
+  try {
+    const resSums = await fetchImpl(sumsUrl);
+    if (resSums.status === 404) {
+      throw new Error('The release predates checksums (SHA256SUMS file missing).');
+    }
+    if (!resSums.ok) throw new Error(`Failed to download SHA256SUMS: ${resSums.statusText}`);
+    sumsContent = await resSums.text();
+  } catch (e) {
+    throw new Error(`Error fetching checksums: ${e instanceof Error ? e.message : String(e)}`);
+  }
+
+  // 3. Download Asset to temp file
+  const tmpPath = path.join(targetDir, `.cpe-update-${process.pid}.tmp`);
+  try {
+    const resAsset = await fetchImpl(assetUrl);
+    if (!resAsset.ok) throw new Error(`Failed to download asset ${assetName}: ${resAsset.statusText}`);
+
+    // Stream the body to a file (using Bun's native ability or standard fs write)
+    // Since we are in Node/Bun environment, let's use a simple buffer for now 
+    // but ideally stream it if possible. For this task, reading as arrayBuffer is fine.
+    const data = await resAsset.arrayBuffer();
+    fs.writeFileSync(tmpPath, Buffer.from(data));
+
+    // 4. Verify Checksum
+    const hasher = new Bun.CryptoHasher('sha256');
+    hasher.update(Buffer.from(data));
+    const actualHash = hasher.digest('hex');
+
+    let expectedHash: string | null = null;
+    const lines = sumsContent.split(/\r?\n/);
+    for (const line of lines) {
+      // Format is usually "hash  filename" or "hash filename"
+      const parts = line.trim().split(/\s+/);
+      if (parts.length >= 2 && parts[1] === assetName) {
+        expectedHash = parts[0];
+        break;
+      }
+    }
+
+    if (!expectedHash) {
+      throw new Error(`Could not find entry for ${assetName} in SHA256SUMS.`);
+    }
+
+    if (actualHash !== expectedHash) {
+      throw new Error(`Checksum mismatch! Expected ${expectedHash}, got ${actualHash}`);
+    }
+
+    // 5. Atomic Swap
+    fs.chmodSync(tmpPath, 0o755);
+    fs.renameSync(tmpPath, execPath);
+  } catch (err) {
+    if (fs.existsSync(tmpPath)) fs.unlinkSync(tmpPath);
+    throw err;
+  }
+}
