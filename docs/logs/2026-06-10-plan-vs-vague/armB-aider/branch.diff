@@ -0,0 +1,39 @@
+import { expect, test } from 'bun:test';
+import * as fs from 'fs';
+import * as path from 'path';
+import * as os from 'os';
+import { readUpdateState, writeUpdateState, shouldCheck } from './state.js';
+
+test('read/write state round-trip', () => {
+  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cpe-state-'));
+  const base = tmpDir;
+  const mockState = { last_checked_at: '2024-01-01T00:00:00Z', latest_seen: 'v1.0.0' };
+
+  writeUpdateState(mockState, base);
+  const result = readUpdateState(base);
+  expect(result).toEqual(mockState);
+
+  fs.rmSync(tmpDir, { recursive: true, force: true });
+});
+
+test('shouldCheck logic', () => {
+  // No state -> true
+  const tmpDir1 = fs.mkdtempSync(path.join(os.tmpdir(), 'cpe-state-1'));
+  expect(shouldCheck(24, new Date(), tmpDir1)).toBe(true);
+
+  // Fresh state (within interval) -> false
+  const mockStateFresh = { last_checked_at: new Date().toISOString() };
+  writeUpdateState(mockStateFresh, tmpDir1);
+  expect(shouldCheck(24, new Date(), tmpDir1)).toBe(false);
+
+  // Old state (outside interval) -> true
+  const mockStateOld = { last_checked_at: '2000-01-01T00:00:00Z' };
+  writeUpdateState(mockStateOld, tmpDir1);
+  expect(shouldCheck(24, new Date(), tmpDir1)).toBe(true);
+
+  // Corrupt state -> true
+  fs.writeFileSync(path.join(tmpDir1, 'update-check.json'), 'not json');
+  expect(shouldCheck(24, new Date(), tmpDir1)).toBe(true);
+
+  fs.rmSync(tmpDir1, { recursive: true, force: true });
+});
