+import { expect, test } from 'bun:test';
+import { compareVersions, isNewer } from './check.js';
+
+test('compareVersions handles basic versioning', () => {
+  expect(compareVersions('v1.0.0', 'v0.9.0')).toBe(1);
+  expect(compareVersions('v2.0.0', 'v2.0.0')).toBe(0);
+  expect(compareVersions('v0.10.0', 'v0.9.0')).toBe(1); // Numeric check
+});
+
+test('compareVersions handles prereleases', () => {
+  // Prerelease is lower than release of same core
+  expect(compareVersions('v1.0.0-rc.1', 'v1.0.0')).toBe(-1);
+  // Lexical comparison for two prereleases
+  expect(compareVersions('v1.0.0-alpha', 'v1.0.0-beta')).toBe(-1);
+});
+
+test('isNewer handles dev builds correctly', () => {
+  expect(isNewer('v2.0.0', 'dev')).toBe(false);
+  expect(isNewer('v2.0.0', 'v1.0.0')).toBe(true);
+});
+
+test('compareVersions strips leading v and handles missing segments', () => {
+  expect(compareVersions('1.0', '1.0.0')).toBe(0);
+  expect(compareVersions('2', '1.9.9')).toBe(1);
+});
