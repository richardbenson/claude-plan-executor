+import { expect, test } from 'bun:test';
+import * as fs from 'fs';
+import * as path from 'path';
+import * as os from 'os';
+import { downloadAndInstall, getAssetName } from './install.js';
+
+test('getAssetName maps platforms correctly', () => {
+  expect(getAssetName('linux', 'x64')).toBe('cpe-linux-x64');
+  expect(getAssetName('darwin', 'arm64')).toBe('cpe-darwin-arm64');
+});
+
+test('getAssetName throws on unsupported platform', () => {
+  expect(() => getAssetName('windows', 'x86')).toThrow();
+});
+
+test('downloadAndInstall happy path (mocked)', async () => {
+  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cpe-install-'));
+  const targetPath = path.join(tmpDir, 'cpe-dummy');
+  fs.writeFileSync(targetPath, Buffer.from('old content'));
+
+  // Mock fetchImpl to return dummy SUMS and asset
+  const mockFetch = (url: string) => {
+    if (url.includes('SHA256SUMS')) {
+      return Promise.resolve({
+        ok: true,
+        status: 200,
+        text: () => Promise.resolve('e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca4230b0fff5bbeline cpe-linux-x64')
+      });
+    }
+    if (url.includes('download')) {
+      // The hash of an empty string is e3b0c4... 
+      // But we want to match the dummy content or just a known one.
+      return Promise.resolve({
+        ok: true,
+        status: 200,
+        arrayBuffer: () => Promise.resolve(new Uint8Array([])) // Empty buffer -> e3b0c4...
+      });
+    }
+    throw new Error('Unexpected URL');
+  };
+
+  // We need to mock process.platform/arch for getAssetName inside downloadAndInstall 
+  // or just ensure the test runs on a supported platform (which it will).
+  // Since we can't easily monkeypatch process, and this is running in an environment where 
+  // these are set, let's assume current env matches.
+
+  try {
+    await downloadAndInstall('v1.0.0', { execPath: targetPath, fetchImpl: mockFetch });
+    const content = fs.readFileSync(targetPath);
+    expect(content).toEqual(Buffer.from([])); // Should be empty because our dummy hash was for empty buffer
+  } finally {
+    fs.rmSync(tmpDir, { recursive: true, force: true });
+  }
+});
+
+test('downloadAndInstall fails on checksum mismatch', async () => {
+  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cpe-install-fail'));
+  const targetPath = path.join(tmpDir, 'cpe-dummy');
+  fs.writeFileSync(targetPath, Buffer.from('old content'));
+
+  const mockFetch = (url: string) => {
+    if (url.includes('SHA256SUMS')) {
+      return Promise.resolve({
+        ok: true,
+        status: 200,
+        text: () => Promise.resolve('wronghash cpe-linux-x64')
+      });
+    }
+    if (url.includes('download')) {
+      return Promise.resolve({
+        ok: true,
+        status: 200,
+        arrayBuffer: () => Promise.resolve(new Uint8Array([]))
+      });
+    }
+    throw new Error('Unexpected URL');
+  };
+
+  try {
+    await downloadAndInstall('v1.0.0', { execPath: targetPath, fetchImpl: mockFetch });
+  } catch (e) {
+    expect(e.message).toContain('Checksum mismatch');
+  } finally {
+    fs.rmSync(tmpDir, { recursive: true, force: true });
+  }
+});
+
+test('downloadAndInstall fails on missing SUMS', async () => {
+  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cpe-install-no-sums'));
+  const targetPath = path.join(tmpDir, 'cpe-dummy');
+  fs.writeFileSync(targetPath, Buffer.from('old content'));
+
+  const mockFetch = (url: string) => {
+    if (url.includes('SHA256SUMS')) {
+      return Promise.resolve({ ok: false, status: 404 });
+    }
+    if (url.includes('download')) {
+      return Promise.resolve({ ok: true, status: 200, arrayBuffer: () => Promise.resolve(new Uint8Array([])) });
+    }
+    throw new Error('Unexpected URL');
+  };
+
+  try {
+    await downloadAndInstall('v1.0.0', { execPath: targetPath, fetchImpl: mockFetch });
+  } catch (e) {
+    expect(e.message).toContain('predates checksums');
+  } finally {
+    fs.rmSync(tmpDir, { recursive: true, force: true });
+  }
+});
