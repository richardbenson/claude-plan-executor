+import type { Request } from 'undici'; // Or just use global fetch types if available, but we need to handle headers
+
+export const REPO_SLUG = 'richardbenson/claude-plan-executor';
+
+/**
+ * Fetches the latest release tag from GitHub.
+ * Uses a manual redirect to avoid API rate limits and get the Location header.
+ */
+export async function fetchLatestTag(timeoutMs: number = 5000): Promise<string> {
+  const url = `https://github.com/${REPO_SLUG}/releases/latest`;
+  
+  try {
+    const response = await fetch(url, {
+      redirect: 'manual',
+      signal: AbortSignal.timeout(timeoutMs),
+    });
+
+    if (response.status !== 302) {
+      throw new Error(`Expected redirect from GitHub releases/latest but got ${response.status}`);
+    }
+
+    const location = response.headers.get('location');
+    if (!location) {
+      throw new Error('Missing Location header in GitHub release redirect.');
+    }
+
+    // The location is usually /releases/tag/<tag> or similar, 
+    // but for the 'latest' endpoint it ends with /tag/<tag>
+    const parts = location.split('/');
+    const tagIndex = parts.lastIndexOf('tag');
+    if (tagIndex === -1 || !parts[tagIndex + 1]) {
+      throw new Error(`Could not parse release tag from Location header: ${location}`);
+    }
+
+    return parts[tagIndex + 1];
+  } catch (err) {
+    if (err instanceof AbortSignal.timeout) {
+      throw new Error(`Timeout fetching latest release from GitHub (${timeoutMs}ms).`);
+    }
+    throw err;
+  }
+}
+
+/**
+ * Compares two version strings. 
+ * Returns > 0 if a is newer, < 0 if b is newer, 0 if equal.
+ */
+export function compareVersions(a: string, b: string): number {
+  const parse = (v: string) => {
+    const [corePart, ...preParts] = v.replace(/^v/, '').split('-');
+    const segments = corePart.split('.').map((s) => parseInt(s, 10));
+    return { segments, prerelease: preParts.join('.') || null };
+  };
+
+  const verA = parse(a);
+  const verB = parse(b);
+
+  // Compare numeric segments
+  for (let i = 0; i < Math.max(verA.segments.length, verB.segments.length); i++) {
+    const segA = verA.segments[i] ?? 0;
+    const segB = verB.segments[i] ?? 0;
+    if (segA > segB) return 1;
+    if (segA < segB) return -1;
+  }
+
+  // Prerelease logic: a version with prerelease is LOWER than the same core without one
+  if (!verA.prerelease && verB.prerelease) return 1;
+  if (verA.prerelease && !verB.prerelease) return -1;
+
+  // If both have prereleases, compare them lexically
+  if (verA.prerelease && verB.prerelease) {
+    if (verA.prerelease === verB.prerelease) return 0;
+    return verA.prerelease > verB.prerelease ? 1 : -1;
+  }
+
+  return 0;
+}
+
+/**
+ * Checks if the latest tag is newer than the current version.
+ */
+export function isNewer(latestTag: string, currentVersion: string): boolean {
+  if (currentVersion === 'dev') return false;
+  return compareVersions(latestTag, currentVersion) > 0;
+}
