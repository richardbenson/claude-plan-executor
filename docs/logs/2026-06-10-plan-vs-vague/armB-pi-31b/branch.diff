diff --git a/scripts/install.sh b/scripts/install.sh
index c2c09cf..83d396e 100755
--- a/scripts/install.sh
+++ b/scripts/install.sh
@@ -24,6 +24,42 @@ echo "Downloading ${ASSET}..."
 
 mkdir -p "$HOME/.local/bin"
 curl -fsSL "$URL" -o "$HOME/.local/bin/cpe"
+
+# Verify checksum if SHA256SUMS is available
+SUMS_URL="https://github.com/richardbenson/claude-plan-executor/releases/latest/download/SHA256SUMS"
+TMP_SUMS=$(mktemp)
+if curl -fsSL "$SUMS_URL" -o "$TMP_SUMS"; then
+  if command -v sha256sum >/dev/null 2>&1; then
+    HASHER="sha256sum"
+    HASH_OPTS=()
+  elif command -v shasum >/dev/null 2>&1; then
+    HASHER="shasum"
+    HASH_OPTS=(-a 256)
+  else
+    echo "[warn] No sha256sum or shasum found; skipping verification."
+    HASHER=""
+  fi
+
+  if [[ -n "${HASHER:-}" ]]; then
+    EXPECTED=$(grep " ${ASSET}$" "$TMP_SUMS" | awk '{print $1}') || true
+    if [[ -z "$EXPECTED" ]]; then
+      echo "[warn] Checksum for ${ASSET} not found in SHA256SUMS; skipping verification."
+    else
+      ACTUAL=$($HASHER "${HASH_OPTS[@]}" "$HOME/.local/bin/cpe" | awk '{print $1}')
+      if [[ "$EXPECTED" != "$ACTUAL" ]]; then
+        echo "Error: Checksum mismatch for ${ASSET}!" >&2
+        rm -f "$HOME/.local/bin/cpe" "$TMP_SUMS"
+        exit 1
+      fi
+      echo "[info]  Checksum verified."
+    fi
+  fi
+  rm -f "$TMP_SUMS"
+else
+  echo "[warn] Could not download SHA256SUMS; skipping verification."
+  rm -f "$TMP_SUMS"
+fi
+
 chmod +x "$HOME/.local/bin/cpe"
 
 echo "Installed: $HOME/.local/bin/cpe"
