@@ -0,0 +1,86 @@
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+/**
+ * Maps the current platform and architecture to a binary asset name.
+ */
+export function assetName(platform?: string, arch?: string): string {
+  const p = platform ?? process.platform;
+  const a = arch ?? process.arch;
+
+  const osMap: Record<string, string> = { linux: 'linux', darwin: 'darwin' };
+  const archMap: Record<string, string> = { x64: 'x64', arm64: 'arm64' };
+
+  const os = osMap[p];
+  const architecture = archMap[a];
+
+  if (!os || !architecture) {
+    throw new Error(`Unsupported platform/arch combination: ${p}/${a}`);
+  }
+
+  return `cpe-${os}-${architecture}`;
+}
+
+/**
+ * Downloads the binary and its checksum, verifies it, and atomically replaces the target.
+ */
+export async function downloadAndInstall(
+  tag: string,
+  opts?: { execPath?: string; fetchImpl?: typeof fetch }
+): Promise<void> {
+  const execPath = opts?.execPath ?? process.execPath;
+  const fetchFn = opts?.fetchImpl ?? fetch;
+  const asset = assetName();
+  const repoSlug = 'richardbenson/claude-plan-executor';
+
+  const sumsUrl = `https://github.com/${repoSlug}/releases/download/${tag}/SHA256SUMS`;
+  const binaryUrl = `https://github.com/${repoSlug}/releases/download/${tag}/${asset}`;
+
+  const tmpDir = path.dirname(execPath);
+  const tmpFile = path.join(tmpDir, `.cpe-update-${process.pid}`);
+
+  try {
+    // 1. Download SHA256SUMS
+    const sumsResponse = await fetchFn(sumsUrl);
+    if (!sumsResponse.ok) {
+      throw new Error(`Failed to download checksums (HTTP ${sumsResponse.status}). The release may predate checksum support.`);
+    }
+    const sumsText = await sumsResponse.text();
+
+    // 2. Find the hash for our asset
+    const lines = sumsText.split('\n');
+    const assetLine = lines.find(line => line.trim().endsWith(`  ${asset}`) || line.trim().endsWith(` ${asset}`));
+    if (!assetLine) {
+      throw new Error(`Checksum for asset ${asset} not found in SHA256SUMS.`);
+    }
+    const expectedHash = assetLine.split(/\s+/)[0];
+
+    // 3. Download binary to temp file
+    const binResponse = await fetchFn(binaryUrl);
+    if (!binResponse.ok) {
+      throw new Error(`Failed to download binary ${asset} (HTTP ${binResponse.status}).`);
+    }
+
+    const buffer = await binResponse.arrayBuffer();
+    fs.writeFileSync(tmpFile, Buffer.from(buffer));
+
+    // 4. Verify SHA256
+    const hasher = new Bun.CryptoHasher('sha256');
+    hasher.update(Buffer.from(buffer));
+    const actualHash = hasher.digest('hex');
+
+    if (actualHash !== expectedHash) {
+      throw new Error(`Checksum mismatch for ${asset}. Expected ${expectedHash}, got ${actualHash}.`);
+    }
+
+    // 5. Atomic swap
+    fs.chmodSync(tmpFile, 0o755);
+    fs.renameSync(tmpFile, execPath);
+  } catch (err) {
+    throw new Error(`Installation failed during step: ${err instanceof Error ? err.message : String(err)}`);
+  } finally {
+    if (fs.existsSync(tmpFile)) {
+      try { fs.unlinkSync(tmpFile); } catch {}
+    }
+  }
+}
