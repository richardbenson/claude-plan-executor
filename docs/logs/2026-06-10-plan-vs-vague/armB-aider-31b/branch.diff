+import { describe, it, expect } from 'bun:test';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import * as os from 'node:os';
+import { readUpdateState, writeUpdateState, shouldCheck } from './state.js';
+
+describe('Update State Management', () => {
+  const getTestBase = () => fs.mkdtempSync(path.join(os.tmpdir(), 'cpe-state-test-'));
+
+  it('readUpdateState returns empty object if file missing', () => {
+    const base = getTestBase();
+    expect(readUpdateState(base)).toEqual({});
+  });
+
+  it('write and read update state', () => {
+    const base = getTestBase();
+    const state = { last_checked_at: '2026-01-01T00:00:00Z', latest_seen: 'v1.0.0' };
+    writeUpdateState(state, base);
+    expect(readUpdateState(base)).toEqual(state);
+  });
+
+  it('shouldCheck returns true if no state exists', () => {
+    const base = getTestBase();
+    expect(shouldCheck(24, new Date(), base)).toBe(true);
+  });
+
+  it('shouldCheck returns false if checked recently', () => {
+    const base = getTestBase();
+    const now = new Date();
+    const recent = new Date(now.getTime() - 1 * 60 * 60 * 1000).toISOString(); // 1 hour ago
+    writeUpdateState({ last_checked_at: recent }, base);
+
+    expect(shouldCheck(24, now, base)).toBe(false);
+  });
+
+  it('shouldCheck returns true if checked long ago', () => {
+    const base = getTestBase();
+    const now = new Date();
+    const old = new Date(now.getTime() - 25 * 60 * 60 * 1000).toISOString(); // 25 hours ago
+    writeUpdateState({ last_checked_at: old }, base);
+
+    expect(shouldCheck(24, now, base)).toBe(true);
+  });
+
+  it('shouldCheck returns true if state is corrupt', () => {
+    const base = getTestBase();
+    const p = path.join(base, 'update-check.json');
+    fs.mkdirSync(path.dirname(p), { recursive: true });
+    fs.writeFileSync(p, 'not json');
+
+    expect(shouldCheck(24, new Date(), base)).toBe(true);
+  });
+});
