@@ -0,0 +1,74 @@
+export const REPO_SLUG = 'richardbenson/claude-plan-executor';
+
+/**
+ * Resolves the latest release tag from GitHub by following a redirect to /releases/latest.
+ */
+export async function fetchLatestTag(timeoutMs: number = 5000): Promise<string> {
+  const url = `https://github.com/${REPO_SLUG}/releases/latest`;
+
+  const response = await fetch(url, {
+    redirect: 'manual',
+    signal: AbortSignal.timeout(timeoutMs),
+  });
+
+  if (response.status !== 302) {
+    throw new Error(`Unexpected response from GitHub: ${response.status}. Expected a redirect to the latest release.`);
+  }
+
+  const location = response.headers.get('location');
+  if (!location) {
+    throw new Error('GitHub did not provide a Location header in the redirect.');
+  }
+
+  // The location is usually https://github.com/user/repo/releases/tag/vX.Y.Z
+  const match = location.match(/\/tag\/([^\/\?#]+)$/);
+  if (!match) {
+    throw new Error(`Could not parse the release tag from the Location header: ${location}`);
+  }
+
+  return match[1];
+}
+
+/**
+ * Compares two version strings numerically.
+ * Returns > 0 if a is newer, < 0 if b is newer, and 0 if equal.
+ */
+export function compareVersions(a: string, b: string): number {
+  const parse = (v: string) => {
+    const clean = v.startsWith('v') ? v.slice(1) : v;
+    const [core, prerelease] = clean.split('-');
+    const segments = core.split('.').map(Number);
+    return { segments, prerelease };
+  };
+
+  const va = parse(a);
+  const vb = parse(b);
+
+  // Compare numeric segments
+  const len = Math.max(va.segments.length, vb.segments.length);
+  for (let i = 0; i < len; i++) {
+    const segA = va.segments[i] ?? 0;
+    const segB = vb.segments[i] ?? 0;
+    if (segA > segB) return 1;
+    if (segA < segB) return -1;
+  }
+
+  // Core versions are equal, handle prerelease logic:
+  // A version with a prerelease suffix is LOWER than the same core without one.
+  if (va.prerelease && !vb.prerelease) return -1;
+  if (!va.prerelease && vb.prerelease) return 1;
+  if (va.prerelease && vb.prerelease) {
+    return va.prerelease.localeCompare(vb.prerelease);
+  }
+
+  return 0;
+}
+
+/**
+ * Returns true if latestTag is strictly newer than currentVersion.
+ * Dev builds never self-update.
+ */
+export function isNewer(latestTag: string, currentVersion: string): boolean {
+  if (currentVersion === 'dev') return false;
+  return compareVersions(latestTag, currentVersion) > 0;
+}
