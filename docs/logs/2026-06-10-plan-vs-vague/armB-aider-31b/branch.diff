@@ -0,0 +1,44 @@
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import * as os from 'node:os';
+
+export interface UpdateState {
+  last_checked_at?: string; // ISO date
+  latest_seen?: string;     // tag version
+}
+
+const getStatePath = (base?: string) => 
+  path.join(base ?? path.join(os.homedir(), '.local/state/cpe'), 'update-check.json');
+
+export function readUpdateState(base?: string): UpdateState {
+  try {
+    const data = fs.readFileSync(getStatePath(base), 'utf8');
+    return JSON.parse(data);
+  } catch {
+    return {};
+  }
+}
+
+export function writeUpdateState(state: UpdateState, base?: string): void {
+  const p = getStatePath(base);
+  fs.mkdirSync(path.dirname(p), { recursive: true });
+  fs.writeFileSync(p, JSON.stringify(state, null, 2) + '\n');
+}
+
+/**
+ * Returns true if the state indicates it is time to check for updates again.
+ */
+export function shouldCheck(intervalHours: number, now: Date = new Date(), base?: string): boolean {
+  const state = readUpdateState(base);
+  if (!state.last_checked_at) return true;
+
+  try {
+    const lastChecked = new Date(state.last_checked_at);
+    if (isNaN(lastChecked.getTime())) return true;
+
+    const diffMs = now.getTime() - lastChecked.getTime();
+    return diffMs > intervalHours * 60 * 60 * 1000;
+  } catch {
+    return true;
+  }
+}
