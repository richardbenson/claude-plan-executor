+import { describe, it, expect } from 'bun:test';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import * as os from 'node:os';
+import { assetName, downloadAndInstall } from './install.js';
+
+describe('Update Installation', () => {
+  it('assetName maps platforms correctly', () => {
+    expect(assetName('linux', 'x64')).toBe('cpe-linux-x64');
+    expect(assetName('linux', 'arm64')).toBe('cpe-linux-arm64');
+    expect(assetName('darwin', 'x64')).toBe('cpe-darwin-x64');
+    expect(assetName('darwin', 'arm64')).toBe('cpe-darwin-arm64');
+  });
+
+  it('assetName throws on unsupported platforms', () => {
+    expect(() => assetName('windows', 'x64')).toThrow('Unsupported platform/arch combination');
+  });
+
+  it('downloadAndInstall replaces binary and verifies checksum', async () => {
+    const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cpe-test-'));
+    const targetFile = path.join(tmpDir, 'cpe');
+    fs.writeFileSync(targetFile, 'old binary content');
+
+    const asset = assetName();
+    const binContent = 'new binary content';
+    const hash = new Bun.CryptoHasher('sha256').update(binContent).digest('hex');
+    const sumsContent = `${hash}  ${asset}\n`;
+
+    const mockFetch = async (url: string) => {
+      if (url.includes('SHA256SUMS')) return { ok: true, text: async () => sumsContent };
+      if (url.includes(asset)) return { ok: true, arrayBuffer: async () => new TextEncoder().encode(binContent).buffer };
+      return { ok: false, status: 404 };
+    };
+
+    await downloadAndInstall('v1.2.3', { execPath: targetFile, fetchImpl: mockFetch });
+
+    expect(fs.readFileSync(targetFile, 'utf8')).toBe(binContent);
+  });
+
+  it('downloadAndInstall fails and cleans up on checksum mismatch', async () => {
+    const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cpe-test-'));
+    const targetFile = path.join(tmpDir, 'cpe');
+    fs.writeFileSync(targetFile, 'old binary content');
+
+    const asset = assetName();
+    const binContent = 'new binary content';
+    const wrongHash = 'wronghash1234567890';
+    const sumsContent = `${wrongHash}  ${asset}\n`;
+
+    const mockFetch = async (url: string) => {
+      if (url.includes('SHA256SUMS')) return { ok: true, text: async () => sumsContent };
+      if (url.includes(asset)) return { ok: true, arrayBuffer: async () => new TextEncoder().encode(binContent).buffer };
+      return { ok: false, status: 404 };
+    };
+
+    await expect(downloadAndInstall('v1.2.3', { execPath: targetFile, fetchImpl: mockFetch }))
+      .rejects.toThrow(/Checksum mismatch/);
+
+    expect(fs.readFileSync(targetFile, 'utf8')).toBe('old binary content');
+  });
+
+  it('downloadAndInstall fails if SUMS file is missing', async () => {
+    const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cpe-test-'));
+    const targetFile = path.join(tmpDir, 'cpe');
+    fs.writeFileSync(targetFile, 'old binary content');
+
+    const mockFetch = async (url: string) => {
+      if (url.includes('SHA256SUMS')) return { ok: false, status: 404 };
+      return { ok: true, arrayBuffer: async () => new ArrayBuffer(0) };
+    };
+
+    await expect(downloadAndInstall('v1.2.3', { execPath: targetFile, fetchImpl: mockFetch }))
+      .rejects.toThrow(/predate checksum support/);
+
+    expect(fs.readFileSync(targetFile, 'utf8')).toBe('old binary content');
+  });
+});
