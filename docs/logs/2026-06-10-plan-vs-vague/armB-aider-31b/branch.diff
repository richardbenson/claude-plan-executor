+import { describe, it, expect } from 'bun:test';
+import { fetchLatestTag, compareVersions, isNewer } from './check.js';
+
+describe('Update Check Logic', () => {
+  it('compareVersions handles basic numeric bumps', () => {
+    expect(compareVersions('v0.1.0', 'v0.1.1')).toBe(-1);
+    expect(compareVersions('v0.2.0', 'v0.1.9')).toBe(1);
+    expect(compareVersions('v1.0.0', 'v1.0.0')).toBe(0);
+  });
+
+  it('compareVersions handles multi-digit segments (numeric, not lexical)', () => {
+    expect(compareVersions('v0.10.0', 'v0.9.0')).toBe(1);
+  });
+
+  it('compareVersions strips leading v', () => {
+    expect(compareVersions('0.2.0', 'v0.1.0')).toBe(1);
+    expect(compareVersions('v0.2.0', '0.1.0')).toBe(1);
+  });
+
+  it('compareVersions handles missing segments as 0', () => {
+    expect(compareVersions('v1', 'v1.0.0')).toBe(0);
+    expect(compareVersions('v1.1', 'v1.1.0')).toBe(0);
+  });
+
+  it('compareVersions handles prerelease ordering (prerelease < release)', () => {
+    expect(compareVersions('v1.0.0-rc.1', 'v1.0.0')).toBe(-1);
+    expect(compareVersions('v1.0.0', 'v1.0.0-beta')).toBe(1);
+  });
+
+  it('compareVersions compares prereleases lexically', () => {
+    expect(compareVersions('v1.0.0-alpha', 'v1.0.0-beta')).toBe(-1);
+  });
+
+  it('isNewer returns false for dev builds', () => {
+    expect(isNewer('v9.9.9', 'dev')).toBe(false);
+  });
+
+  it('isNewer correctly identifies newer tags', () => {
+    expect(isNewer('v0.2.0', 'v0.1.0')).toBe(true);
+    expect(isNewer('v0.1.0', 'v0.2.0')).toBe(false);
+    expect(isNewer('v0.1.0', 'v0.1.0')).toBe(false);
+  });
+
+  it('fetchLatestTag throws on non-302 response', async () => {
+    // Mock global fetch for this test
+    const originalFetch = global.fetch;
+    global.fetch = async () => ({ status: 200, headers: new Map() } as any);
+
+    await expect(fetchLatestTag()).rejects.toThrow('Unexpected response from GitHub');
+
+    global.fetch = originalFetch;
+  });
+
+  it('fetchLatestTag parses the tag from Location header', async () => {
+    const originalFetch = global.fetch;
+    global.fetch = async () => ({
+      status: 302,
+      headers: new Map([['location', 'https://github.com/richardbenson/claude-plan-executor/releases/tag/v1.2.3']]),
+    } as any);
+
+    const tag = await fetchLatestTag();
+    expect(tag).toBe('v1.2.3');
+
+    global.fetch = originalFetch;
+  });
+});
