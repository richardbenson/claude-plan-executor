+++ b/src/update/install.ts
@@ -0,0 +1,130 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import { REPO_SLUG } from './check.js';
+
+/**
+ * Maps the current platform and architecture to the expected asset name format.
+ */
+export function getAssetName(): string {
+  const platforms: Record<string, string> = {
+    linux: 'linux',
+    darwin: 'darwin'
+  };
+  const archs: Record<string, string> = {
+    x64: 'x64',
+    arm64: 'arm64'
+  };
+
+  const platform = platforms[process.platform];
+  if (!platform) {
+    throw new Error(`Unsupported platform: ${process.platform}`);
+  }
+
+  const arch = archs[process.arch as string];
+  if (!arch) {
+    throw new Error(`Unsupported architecture: ${process.arch}`);
+  }
+
+  return `cpe-${platform}-${arch}`;
+}
+
+/**
+ * Downloads and installs the latest release asset, verifying its checksum.
+ */
+export async function downloadAndInstall(
+  tag: string, 
+  opts?: { execPath?: string; fetchImpl?: typeof fetch }
+): Promise<void> {
+  const execPath = opts?.execPath ?? process.execPath;
+  const fetchImpl = opts?.fetchImpl ?? (global as any).fetch;
+  const assetName = getAssetName();
+
+  let tmpPath: string | null = null;
+
+  try {
+    // 1. Download SHA256SUMS
+    const sumsUrl = `https://github.com/${REPO_SLUG}/releases/download/${tag}/SHA256SUMS`;
+    const sumsResponse = await fetchImpl(sumsUrl);
+    if (!sumsResponse.ok) {
+      throw new Error(`Failed to download SHA256SUMS from ${sumsUrl}: ${sumsResponse.statusText}`);
+    }
+
+    let sumsContent: string;
+    try {
+      sumsContent = await sumsResponse.text();
+    } catch (e) {
+       throw new Error(`Failed to read SHA256SUMS content.`);
+    }
+
+    const sumLines = sumsContent.split('\n');
+    let expectedHash: string | null = null;
+
+    for (const line of sumLines) {
+      if (!line.trim()) continue;
+      // SUMS format is usually "hash  filename" or "hash filename"
+      const parts = line.trim().split(/\s+/);
+      if (parts[parts.length - 1] === assetName) {
+        expectedHash = parts[0];
+        break;
+      }
+    }
+
+    if (!expectedHash) {
+      throw new Error(`The release predates checksums or the expected asset "${assetName}" was not found in SHA256SUMS.`);
+    }
+
+    // 2. Download Asset and write to temp file while computing hash
+    const assetUrl = `https://github.com/${REPO_SLUG}/releases/download/${tag}/${assetName}`;
+    const assetResponse = await fetchImpl(assetUrl);
+    if (!assetResponse.ok) {
+      throw new Error(`Failed to download asset ${assetName} from ${assetUrl}: ${assetResponse.statusText}`);
+    }
+
+    tmpPath = path.join(path.dirname(execPath), `.cpe-update-${process.pid}`);
+    
+    // Ensure we don't have a stale file from a previous failed run (though finally should handle it)
+    if (fs.existsSync(tmpPath)) {
+      try { fs.unlinkSync(tmpPath); } catch {}
+
+    const body = assetResponse.body as any;
+    if (!body || typeof body.getReader !== 'function') {
+      throw new Error('Failed to get readable stream from asset response.');
+    }
+
+    const reader = body.getReader();
+    const fileHandle = await fs.promises.open(tmpPath, 'w');
+    try {
+      const hasher = new Bun.CryptoHasher('sha256');
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        await fileHandle.write(value);
+        hasher.update(value);
+      }
+    } finally {
+      await fileHandle.close();
+    }
+
+    // 3. Verify Checksum
+    const actualHash = hasher.digest('hex');
+    if (actualHash !== expectedHash) {
+      throw new Error(`Checksum mismatch! Expected ${expectedHash}, got ${actualHash}`);
+    }
+
+    // 4. Install
+    fs.chmodSync(tmpPath, 0o755);
+    fs.renameSync(tmpPath, execPath);
+
+  } catch (err) {
+    if (err instanceof Error && !err.message.includes('Checksum mismatch')) {
+      throw new Error(`Download and install failed: ${err.message}`);
+    }
+    throw err; // Rethrow if it's already a descriptive error like checksum mismatch
+  } finally {
+    if (tmpPath && fs.existsSync(tmpPath)) {
+      try {
+        fs.unlinkSync(tmpPath);
+      } catch (e) {}
+    }
+  }
+}
