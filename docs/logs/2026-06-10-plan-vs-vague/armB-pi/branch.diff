diff --git a/src/update/check.ts b/src/update/check.ts
new file mode 100644
index 0000000..2b56cd8
--- /dev/null
+++ b/src/update/check.ts
@@ -0,0 +1,103 @@
+import * as fetcher from 'fetch';
+
+export const REPO_SLUG = 'richardbenson/claude-plan-executor';
+
+/**
+ * Fetches the latest release tag for the project.
+ * Uses a manual redirect to capture the location header correctly.
+ */
+export async function fetchLatestTag(timeoutMs: number = 5000): Promise<string> {
+  const url = `https://github.com/${REPO_SLUG}/releases/latest`;
+  
+  try {
+    const response = await fetch(url, {
+      redirect: 'manual',
+      signal: AbortSignal.timeout(timeoutMs),
+    });
+
+    if (response.status === 302 || response.status === 301) {
+      const location = response.headers.get('location');
+      if (!location) {
+        throw new Error('Missing "location" header in redirect from GitHub.');
+      }
+      // The location might be a full URL, we want the final path segment after /tag/ or just the tag itself if it's a direct link to release.
+      // Actually for releases/latest, github usually redirects to something like https://github.com/user/repo/releases/tag/v1.2.3
+      const parts = location.split('/');
+      const tagPart = parts[parts.length - 1];
+      if (!tagPart || !tagPart.startsWith('v')) {
+         // Fallback: try to find the part after /tag/
+         const index = location.lastIndexOf('/tag/');
+         if (index !== -1) {
+           return location.substring(index + 5);
+         }
+      }
+      return tagPart;
+    }
+
+    if (!response.ok) {
+      throw new Error(`Failed to fetch latest release: ${response.statusText}`);
+    }
+
+    // If we get a 200 OK, it means something is weird (maybe no releases?)
+    throw new Error('Unexpected 200 OK response from GitHub releases/latest.');
+  } catch (err) {
+    if (err instanceof Error && err.name === 'TimeoutError') {
+      throw new Error(`Fetching latest tag timed out after ${timeoutMs}ms.`);
+    }
+    throw err;
+  }
+}
+
+/**
+ * Compares two version strings.
+ * Returns > 0 if a is newer, < 0 if b is newer, and 0 if they are equal.
+ */
+export function compareVersions(a: string, b: string): number {
+  const parse = (v: string) => {
+    const [coreStr, ...prereleaseParts] = v.replace(/^v/, '').split('-');
+    const coreSegments = coreStr.split('.').map(s => parseInt(s, 10));
+    // If a segment is missing or NaN, treat as 0
+    for (let i = 0; i < coreSegments.length; i++) {
+      if (isNaN(coreSegments[i])) coreSegments[i] = 0;
+    }
+    const prerelease = prereleaseParts.join('-').trim();
+    return { core: coreSegments, prerelease };
+  };
+
+  const vA = parse(a);
+  const vB = parse(b);
+
+  // Compare core segments numerically
+  for (let i = 0; i < Math.max(vA.core.length, vB.core.length); i++) {
+    const segA = vA.core[i] ?? 0;
+    const segB = vB.core[i] ?? 0;
+    if (segA > segB) return 1;
+    if (segA < segB) return -1;
+  }
+
+  // Prerelease logic: A version with a prerelease suffix is LOWER than the same core without one.
+  // If both have no prerelease, they are equal at this point.
+  const hasPrereleaseA = !!vA.prerelease && vA.prerelease !== '';
+  const hasPrereleaseB = !!vB.prerelease && vB.prerelease !== '';
+
+  if (!hasPrereleaseA && hasPrereleaseB) return 1; // A is release, B is prerelease -> A > B
+  if (hasPrereleaseA && !hasPrereleaseB) return -1; // A is prerelease, B is release -> A < B
+
+  // If both have prereleases, compare them lexically.
+  if (hasPrereleaseA && hasPrereleaseB) {
+    if (vA.prerelease > vB.prerelease) return 1;
+    if (vA.prerelease < vB.prerelease) return -1;
+  }
+
+  return 0;
+}
+
+/**
+ * Checks if the latest tag is newer than the current version.
+ */
+export function isNewer(latestTag: string, currentVersion: string): boolean {
+  if (currentVersion === 'dev') {
+    return false;
+  }
+  return compareVersions(latestTag, currentVersion) > 0;
+}
