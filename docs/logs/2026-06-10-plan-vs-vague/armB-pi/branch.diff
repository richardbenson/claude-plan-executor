+++ b/src/update/nudge.ts
@@ -0,0 +1,54 @@
+import { CPE_VERSION } from '../version.js';
+import * as fetcher from './check.js';
+import { shouldCheck } from './check.js';
+import { readConfig } from '../storage/config.js';
+import { writeUpdateState } from './state.js';
+
+/**
+ * Determines whether the application should check for updates based on current state and interval,
+ * then prints a nudge to stderr if an update is available.
+ */
+export async function maybePrintUpdateNudge(
+  argv: string[],
+  deps?: {
+    fetchLatestTag?: (timeoutMs?: number) => Promise<string>;
+    shouldCheck?: (intervalHours: number, now?: Date, base?: string) => boolean;
+    readConfig?: () => any;
+    writeUpdateState?: (state: Record<string, any>, base?: string) => void;
+  } = {}
+): Promise<void> {
+  const {
+    fetchLatestTag = fetcher.fetchLatestTag,
+    shouldCheck = fetcher.shouldCheck,
+    readConfig = readConfig,
+    writeUpdateState = writeUpdateState,
+  } = deps;
+
+  // Return immediately for start and update commands as they handle their own updates/checks.
+  const args = argv[2] ?? ''; // Simple check of the first argument after 'cpe'
+  if (args === 'start' || args === 'update') {
+    return;
+  }
+
+  // Skip conditions: dev build, update_auto disabled, or throttle period not met.
+  const config = readConfig();
+  if (CPE_VERSION === 'dev' || config.update_auto === false || !shouldCheck(24)) {
+    return;
+  }
+
+  try {
+    // Short timeout for the nudge fetch to avoid delaying command execution.
+    const latest = await fetchLatestTag(2000);
+
+    writeUpdateState({
+      last_checked_at: new Date().toISOString(),
+      latest_seen: latest,
+    });
+
+    if (fetcher.isNewer(latest, CPE_VERSION)) {
+      process.stderr.write(`update available: ${latest} — run cpe update\n`);
+    }
+  } catch {
+    // Nudge is best-effort; never throw and don't affect command exit codes or output stream ordering.
+  }
+}
