+import * as assert from 'assert';
+import { describe, it, expect } from 'bun:test';
+import * as path from 'path';
+import * as os from 'os';
+import * as fs from 'fs';
+import { readUpdateState, writeUpdateState, shouldCheck } from './state.js';
+
+describe('update state', () => {
+  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cpe-state-test-'));
+
+  afterAll(() => {
+    fs.rmSync(tmpDir, { recursive: true });
+  });
+
+  it('should return empty object if no state file exists', () => {
+    const state = readUpdateState(tmpDir);
+    expect(state).toEqual({});
+  });
+
+  it('should read existing state correctly', () => {
+    const testDate = new Date();
+    writeUpdateState({ last_checked_at: testDate.toISOString(), latest_seen: 'v1.0.0' }, tmpDir);
+    const state = readUpdateState(tmpDir);
+    expect(state).toEqual({ 
+      last_checked_at: testDate.toISOString(), 
+      latest_seen: 'v1.0.0' 
+    });
+  });
+
+  it('should return true for shouldCheck if no state exists', () => {
+    const now = new Date();
+    expect(shouldCheck(1, now)).toBe(true);
+  });
+
+  it('should return false for shouldCheck if last checked within interval', () => {
+    const testDate = new Date();
+    testDate.setHours(testDate.getHours() - 0.5); // 30 mins ago
+    writeUpdateState({ last_checked_at: testDate.toISOString() }, tmpDir);
+
+    expect(shouldCheck(1, new Date())).toBe(false);
+  });
+
+  it('should return true for shouldCheck if last checked outside interval', () => {
+    const testDate = new Date();
+    testDate.setHours(testDate.getHours() - 2); // 2 hours ago
+    writeUpdateState({ last_checked_at: testDate.toISOString() }, tmpDir);
+
+    expect(shouldCheck(1, new Date())).toBe(true);
+  });
+
+  it('should return true for shouldCheck if state is unparseable', () => {
+    fs.writeFileSync(path.join(tmpDir, '.local/state/cpe/update-check.json'), 'invalid json');
+    // Note: readUpdateState uses path.resolve(base, DEFAULT_STATE_PATH) 
+    // but wait, my implementation of readUpdateState does this:
+    // const fullPath = base ? path.resolve(base, DEFAULT_STATE_PATH) : ...
+    // So if I pass tmpDir as base, it looks for .local/state/cpe/update-check.json relative to tmpDir? 
+    // Actually my implementation was:
+    // const fullPath = base ? path.resolve(base, DEFAULT_STATE_PATH) : ...
+    // and DEFAULT_STATE_PATH is '.local/state/cpe/update-check.json'.
+    // So it will look for tmpDir/.local/state/cpe/update-check.json. 
+
+    expect(shouldCheck(1, new Date(), tmpDir)).toBe(true);
+  });
+});
