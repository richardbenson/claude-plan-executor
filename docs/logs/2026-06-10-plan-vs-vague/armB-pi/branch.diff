+++ b/src/commands/update.ts
@@ -0,0 +1,46 @@
+import { CPE_VERSION } from '../version.js';
+import * as fetcher from '../update/check.js';
+import { downloadAndInstall } from '../update/install.js';
+import { writeUpdateState } from '../update/state.js';
+
+/**
+ * Updates cpe to the latest version available on GitHub releases.
+ */
+export async function updateCommand(opts: { check?: boolean }): Promise<void> {
+  if (CPE_VERSION === 'dev') {
+    console.log('self-update is disabled for dev builds');
+    console.log('to rebuild, use scripts/install-local.sh');
+    return;
+  }
+
+  try {
+    const latest = await fetcher.fetchLatestTag();
+
+    if (opts.check) {
+      console.log(`current version: ${CPE_VERSION}`);
+      console.log(`latest tag: ${latest}`);
+
+      if (fetcher.isNewer(latest, CPE_VERSION)) {
+        console.log('update available — run cpe update');
+      } else {
+        console.log('already up to date');
+      }
+    } else {
+      if (fetcher.isNewer(latest, CPE_VERSION)) {
+        console.log(`downloading latest version (${latest})...`);
+        await downloadAndInstall(latest);
+        console.log(`updated ${CPE_VERSION} → ${latest}`);
+        console.log('note: any running cpe start session is still on the old version and should be restarted.');
+      } else {
+        console.log(`already up to date (${CPE_VERSION})`);
+      }
+    }
+
+    writeUpdateState({
+      last_checked_at: new Date().toISOString(),
+      latest_seen: latest,
+    });
+  } catch (err) {
+    throw err;
+  }
+}
