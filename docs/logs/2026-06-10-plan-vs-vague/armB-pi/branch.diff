--- /dev/null
+++ b/src/update/state.ts
@@ -0,0 +1,63 @@
+import * as fs from 'fs';
+import * as path from 'path';
+
+const DEFAULT_STATE_PATH = '.local/state/cpe/update-check.json';
+
+/**
+ * Reads the update check state. Returns an empty object if no file exists or is unparseable.
+ */
+export function readUpdateState(base?: string): Record<string, any> {
+  const fullPath = base ? path.join(base, DEFAULT_STATE_PATH) : path.resolve(process.env.HOME || '.', DEFAULT_STATE_PATH);
+
+  try {
+    if (!fs.existsSync(fullPath)) {
+      return {};
+    }
+    const content = fs.readFileSync(fullPath, 'utf8');
+    return JSON.parse(content) || {};
+  } catch (err) {
+    // If unparseable or other error, return empty object as per instructions "unparseable state" -> true in shouldCheck
+    return {};
+  }
+}
+
+/**
+ * Writes the update check state to disk.
+ */
+export function writeUpdateState(state: Record<string, any>, base?: string): void {
+  const fullPath = base ? path.join(base, DEFAULT_STATE_PATH) : path.resolve(process.env.HOME || '.', DEFAULT_STATE_PATH);
+
+  try {
+    fs.mkdirSync(path.dirname(fullPath), { recursive: true });
+    fs.writeFileSync(fullPath, JSON.stringify(state, null, 2) + '\n');
+  } catch (err) {
+    throw new Error(`Failed to write update state: ${err.message}`);
+  }
+}
+
+/**
+ * Determines whether the application should check for updates based on current state and interval.
+ */
+export function shouldCheck(intervalHours: number, now?: Date, base?: string): boolean {
+  const date = now || new Date();
+  const state = readUpdateState(base);
+  const lastCheckedAtStr = state.last_checked_at;
+
+  if (!lastCheckedAtStr) {
+    return true;
+  }
+
+  try {
+    const lastCheckedAt = new Date(lastCheckedAtStr);
+    if (isNaN(lastCheckedAt.getTime())) {
+      return true; // Unparseable state
+    }
+
+    const diffMs = date.getTime() - lastCheckedAt.getTime();
+    const diffHours = diffMs / (1000 * 60 * 60);
+
+    return diffHours >= intervalHours;
+  } catch {
+    return true; // Unparseable state
+  }
+}
