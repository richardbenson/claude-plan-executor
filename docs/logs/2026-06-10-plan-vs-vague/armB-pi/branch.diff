+import { expect, test, describe } from "bun:test";
+import { maybePrintUpdateNudge } from "./nudge.js";
+
+describe("maybePrintUpdateNudge", () => {
+  let capturedOutput: string[] = [];
+  const originalStderrWrite = process.stderr.write;
+
+  beforeEach(() => {
+    capturedOutput = [];
+    process.stderr.write = (msg: string) => {
+      capturedOutput.push(msg);
+    };
+  });
+
+  afterAll(() => {
+    process.stderr.write = originalStderrWrite;
+  });
+
+  test("skips if command is start", async () => {
+    await maybePrintUpdateNudge(["cpe", "start"]);
+    expect(capturedOutput).toHaveLength(0);
+  });
+
+  test("skips if command is update", async () => {
+    await maybePrintUpdateNudge(["cpe", "update"]);
+    expect(capturedOutput).toHaveLength(0);
+  });
+
+  test("skips when dev version (if CPE_VERSION === 'dev')", async () => {
+    // If it's not 'dev', this test won't really check the skip, but if it is 'dev', it will.
+    await maybePrintUpdateNudge(["cpe", "other"]);
+    if (process.env.CPE_VERSION === 'dev') {
+      expect(capturedOutput).toHaveLength(0);
+    }
+  });
+
+  test("skips when update_auto is false", async () => {
+    await maybePrintUpdateNudge(["cpe", "other"], {
+      readConfig: () => ({ update_auto: false }),
+      fetchLatestTag: async () => 'v2.0.0',
+      shouldCheck: (h) => h > 1,
+    });
+    expect(capturedOutput).toHaveLength(0);
+  });
+
+  test("skips when throttle says no", async () => {
+    await maybePrintUpdateNudge(["cpe", "other"], {
+      readConfig: () => ({ update_auto: true }),
+      fetchLatestTag: async () => 'v2.0.0',
+      shouldCheck: (h) => h < 1, // returns false
+    });
+    expect(capturedOutput).toHaveLength(0);
+  });
+
+  test("emits nudge when update available", async () => {
+    await maybePrintUpdateNudge(["cpe", "other"], {
+      readConfig: () => ({ update_auto: true }),
+      fetchLatestTag: async () => 'v2.0.0',
+      shouldCheck: (h) => h > 1,
+    });
+
+    expect(capturedOutput).toHaveLength(1);
+    expect(capturedOutput[0]).toContain("update available: v2.0.0");
+  });
+
+  test("handles fetch errors gracefully", async () => {
+    await maybePrintUpdateNudge(["cpe", "other"], {
+      readConfig: () => ({ update_auto: true }),
+      fetchLatestTag: async () => { throw new Error("Failed"); },
+      shouldCheck: (h) => h > 1,
+    });
+
+    expect(capturedOutput).toHaveLength(0);
+  });
+});
