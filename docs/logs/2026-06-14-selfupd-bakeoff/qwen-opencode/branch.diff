index c2c09cf..82c99bc 100755
--- a/scripts/install.sh
+++ b/scripts/install.sh
@@ -18,12 +18,46 @@ esac
 
 ASSET="cpe-${os}-${arch}"
 URL="https://github.com/richardbenson/claude-plan-executor/releases/latest/download/${ASSET}"
+SUMS_URL="https://github.com/richardbenson/claude-plan-executor/releases/latest/download/SHA256SUMS"
 
 echo "Detected platform: ${os}-${arch}"
 echo "Downloading ${ASSET}..."
 
 mkdir -p "$HOME/.local/bin"
-curl -fsSL "$URL" -o "$HOME/.local/bin/cpe"
+TMPDIR=$(mktemp -d)
+trap 'rm -rf "$TMPDIR"' EXIT
+
+curl -fsSL "$URL" -o "$TMPDIR/cpe"
+
+SUMS_TMP="$TMPDIR/SHA256SUMS"
+if curl -fsSL "$SUMS_URL" -o "$SUMS_TMP" 2>/dev/null; then
+  if command -v sha256sum >/dev/null 2>&1; then
+    SUM_CMD="sha256sum"
+  elif command -v shasum >/dev/null 2>&1; then
+    SUM_CMD="shasum -a 256"
+  else
+    echo "[warn] No sha256sum or shasum available; skipping verification" >&2
+    exit 0
+  fi
+  SUM_LINE=$(grep "  ${ASSET}$" "$SUMS_TMP" || true)
+  if [ -n "$SUM_LINE" ]; then
+    EXPECTED_HASH=$(echo "$SUM_LINE" | awk '{print $1}')
+    ACTUAL_HASH=$("$SUM_CMD" "$TMPDIR/cpe" | awk '{print $1}')
+    if [ "$EXPECTED_HASH" != "$ACTUAL_HASH" ]; then
+      rm -f "$TMPDIR/cpe"
+      echo "[error] SHA256 verification failed for ${ASSET}" >&2
+      echo "        Expected: $EXPECTED_HASH" >&2
+      echo "        Got:      $ACTUAL_HASH" >&2
+      exit 1
+    fi
+  else
+    echo "[warn] SHA256SUMS does not contain entry for ${ASSET}; skipping verification" >&2
+  fi
+else
+  echo "[warn] SHA256SUMS not available; skipping verification" >&2
+fi
+
+cp "$TMPDIR/cpe" "$HOME/.local/bin/cpe"
 chmod +x "$HOME/.local/bin/cpe"
 
 echo "Installed: $HOME/.local/bin/cpe"
