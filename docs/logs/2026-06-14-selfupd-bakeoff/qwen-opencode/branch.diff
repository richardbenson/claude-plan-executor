+++ b/src/update/state.ts
@@ -0,0 +1,40 @@
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+
+type UpdateState = { last_checked_at?: string; latest_seen?: string };
+
+const STATE_BASE = path.join(os.homedir(), '.local', 'state', 'cpe');
+
+function getUpdateStatePath(base?: string): string {
+  return path.join(base ?? STATE_BASE, 'update-check.json');
+}
+
+function readUpdateState(base?: string): UpdateState {
+  const statePath = getUpdateStatePath(base);
+  try {
+    const raw = fs.readFileSync(statePath, 'utf8');
+    return JSON.parse(raw) as UpdateState;
+  } catch {
+    return {};
+  }
+}
+
+function writeUpdateState(state: UpdateState, base?: string): void {
+  const statePath = getUpdateStatePath(base);
+  fs.mkdirSync(path.dirname(statePath), { recursive: true });
+  fs.writeFileSync(statePath, JSON.stringify(state, null, 2) + '\n');
+}
+
+function shouldCheck(state: UpdateState): boolean {
+  const last = state.last_checked_at;
+  if (!last) {
+    return true;
+  }
+  const lastDate = new Date(last).getTime();
+  const now = Date.now();
+  const hoursSinceCheck = (now - lastDate) / (1000 * 60 * 60);
+  return hoursSinceCheck >= 24;
+}
+
+export { readUpdateState, writeUpdateState, shouldCheck, UpdateState, getUpdateStatePath };
