index 0000000..8bce4cd
--- /dev/null
+++ b/src/update/install.ts
@@ -0,0 +1,102 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import { REPO_SLUG } from './check.js';
+
+export function assetName(): string {
+  const platform = process.platform;
+  const arch = process.arch;
+
+  if (platform === 'linux' && arch === 'x64') {
+    return 'cpe-linux-x64';
+  }
+  if (platform === 'linux' && arch === 'arm64') {
+    return 'cpe-linux-arm64';
+  }
+  if (platform === 'darwin' && arch === 'x64') {
+    return 'cpe-darwin-x64';
+  }
+  if (platform === 'darwin' && arch === 'arm64') {
+    return 'cpe-darwin-arm64';
+  }
+
+  throw new Error(`Unsupported platform: ${platform}-${arch}`);
+}
+
+export async function downloadAndInstall(
+  tag: string,
+  opts?: { execPath?: string; fetchImpl?: typeof fetch },
+): Promise<void> {
+  const execPath = opts?.execPath ?? process.execPath;
+  const fetchImpl = opts?.fetchImpl ?? fetch;
+
+  const asset = assetName();
+  const baseUrl = `https://github.com/${REPO_SLUG}/releases/download/${tag}`;
+  const sumsUrl = `${baseUrl}/SHA256SUMS`;
+  const assetUrl = `${baseUrl}/${asset}`;
+
+  const tempDir = path.dirname(execPath);
+  const tempPath = path.join(tempDir, `.cpe-update-${process.pid}`);
+
+  try {
+    let sumsContent: string;
+    try {
+      const sumsRes = await fetchImpl(sumsUrl);
+      if (!sumsRes.ok) {
+        throw new Error(`Failed to download SHA256SUMS: ${sumsRes.status} ${sumsRes.statusText}`);
+      }
+      sumsContent = await sumsRes.text();
+    } catch (err) {
+      throw new Error(
+        `Failed to download SHA256SUMS. The release may predate checksums. Original error: ${err}`,
+      );
+    }
+
+    let assetBuffer: ArrayBuffer;
+    try {
+      const assetRes = await fetchImpl(assetUrl);
+      if (!assetRes.ok) {
+        throw new Error(`Failed to download asset: ${assetRes.status} ${assetRes.statusText}`);
+      }
+      assetBuffer = await assetRes.arrayBuffer();
+    } catch (err) {
+      throw new Error(`Download error: ${err}`);
+    }
+
+    const hasher = new Bun.CryptoHasher('sha256');
+    hasher.update(new Uint8Array(assetBuffer));
+    const actualHash = hasher.digest('hex');
+
+    const sumsLines = sumsContent.split('\n');
+    let found = false;
+    let expectedHash: string | undefined;
+    for (const line of sumsLines) {
+      const trimmed = line.trim();
+      if (!trimmed) continue;
+      const parts = trimmed.split(/\s+/);
+      if (parts.length >= 2) {
+        const filename = parts[1];
+        if (filename === asset) {
+          found = true;
+          expectedHash = parts[0];
+          break;
+        }
+      }
+    }
+
+    if (!found) {
+      throw new Error('SHA256SUMS does not contain entry for ' + asset);
+    }
+
+    if (actualHash !== expectedHash) {
+      throw new Error(`Hash mismatch for ${asset}: expected ${expectedHash}, got ${actualHash}`);
+    }
+
+    fs.writeFileSync(tempPath, new Uint8Array(assetBuffer));
+    fs.chmodSync(tempPath, 0o755);
+    fs.renameSync(tempPath, execPath);
+  } finally {
+    if (fs.existsSync(tempPath)) {
+      fs.unlinkSync(tempPath);
+    }
+  }
+}
