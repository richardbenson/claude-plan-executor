@@ -0,0 +1,88 @@
+import { expect, test, beforeEach, afterEach } from 'bun:test';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { readUpdateState, writeUpdateState, shouldCheck, getUpdateStatePath } from './state.js';
+
+let tmpDir: string;
+
+beforeEach(() => {
+  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cpe-test-'));
+});
+
+afterEach(() => {
+  fs.rmSync(tmpDir, { recursive: true, force: true });
+});
+
+test('getUpdateStatePath uses default base when no argument provided', () => {
+  const expected = path.join(os.homedir(), '.local', 'state', 'cpe', 'update-check.json');
+  expect(getUpdateStatePath()).toBe(expected);
+});
+
+test('getUpdateStatePath uses custom base when provided', () => {
+  const customBase = '/tmp/test-cpe';
+  const expected = path.join(customBase, 'update-check.json');
+  expect(getUpdateStatePath(customBase)).toBe(expected);
+});
+
+test('readUpdateState returns empty object when state file does not exist', () => {
+  const state = readUpdateState(tmpDir);
+  expect(state).toEqual({});
+});
+
+test('readUpdateState parses existing state file', () => {
+  const statePath = path.join(tmpDir, 'update-check.json');
+  const initialState = { last_checked_at: '2026-06-14T10:00:00.000Z', latest_seen: 'v1.2.3' };
+  fs.writeFileSync(statePath, JSON.stringify(initialState, null, 2) + '\n');
+
+  const state = readUpdateState(tmpDir);
+  expect(state).toEqual(initialState);
+});
+
+test('readUpdateState returns empty object on parse error', () => {
+  const statePath = path.join(tmpDir, 'update-check.json');
+  fs.writeFileSync(statePath, 'invalid json');
+
+  const state = readUpdateState(tmpDir);
+  expect(state).toEqual({});
+});
+
+test('writeUpdateState creates directory and writes state file', () => {
+  const state = { last_checked_at: '2026-06-14T12:00:00.000Z', latest_seen: 'v1.2.4' };
+  writeUpdateState(state, tmpDir);
+
+  const statePath = path.join(tmpDir, 'update-check.json');
+  expect(fs.existsSync(statePath)).toBe(true);
+  const content = fs.readFileSync(statePath, 'utf8');
+  const parsed = JSON.parse(content);
+  expect(parsed).toEqual(state);
+});
+
+test('writeUpdateState writes with trailing newline and 2-space indent', () => {
+  const state = { last_checked_at: '2026-06-14T12:00:00.000Z' };
+  writeUpdateState(state, tmpDir);
+
+  const statePath = path.join(tmpDir, 'update-check.json');
+  const content = fs.readFileSync(statePath, 'utf8');
+  expect(content.endsWith('\n')).toBe(true);
+  expect(content.includes('\n  "')).toBe(true);
+});
+
+test('shouldCheck returns true when last_checked_at is undefined', () => {
+  expect(shouldCheck({})).toBe(true);
+});
+
+test('shouldCheck returns true when more than 24 hours have passed', () => {
+  const oldDate = new Date(Date.now() - 25 * 60 * 60 * 1000).toISOString();
+  expect(shouldCheck({ last_checked_at: oldDate })).toBe(true);
+});
+
+test('shouldCheck returns false when less than 24 hours have passed', () => {
+  const recentDate = new Date(Date.now() - 12 * 60 * 60 * 1000).toISOString();
+  expect(shouldCheck({ last_checked_at: recentDate })).toBe(false);
+});
+
+test('shouldCheck returns true when exactly 24 hours have passed', () => {
+  const exactly24h = new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString();
+  expect(shouldCheck({ last_checked_at: exactly24h })).toBe(true);
+});
