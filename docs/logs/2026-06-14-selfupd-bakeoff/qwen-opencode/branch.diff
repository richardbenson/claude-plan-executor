index 0000000..14a5a88
--- /dev/null
+++ b/src/update/check.ts
@@ -0,0 +1,64 @@
+export const REPO_SLUG = 'richardbenson/claude-plan-executor';
+
+export function fetchLatestTag(timeoutMs: number = 5000): Promise<string> {
+  return fetch('https://github.com/' + REPO_SLUG + '/releases/latest', {
+    redirect: 'manual',
+    signal: AbortSignal.timeout(timeoutMs),
+  }).then((res) => {
+    const location = res.headers.get('location');
+    if (!location) {
+      throw new Error('Missing location header in GitHub release redirect');
+    }
+    const match = location.match(/\/tag\/([^\/]+)$/);
+    if (!match) {
+      throw new Error('Could not parse tag from location header: ' + location);
+    }
+    return match[1]!;
+  });
+}
+
+function parseVersion(version: string): { core: number[]; prerelease?: string } {
+  const stripped = version.startsWith('v') ? version.slice(1) : version;
+  const parts = stripped.split('-');
+  const segments = parts[0]!.split('.');
+  const core: number[] = segments.map((n) => {
+    const num = parseInt(n, 10);
+    return isNaN(num) ? 0 : num;
+  });
+  const prerelease = parts.length > 1 ? parts[1]! : undefined;
+  return { core, prerelease };
+}
+
+export function compareVersions(a: string, b: string): number {
+  const va = parseVersion(a);
+  const vb = parseVersion(b);
+
+  const maxLen = Math.max(va.core.length, vb.core.length);
+  for (let i = 0; i < maxLen; i++) {
+    const na = va.core[i] || 0;
+    const nb = vb.core[i] || 0;
+    if (na !== nb) {
+      return na - nb;
+    }
+  }
+
+  if (va.prerelease === undefined && vb.prerelease !== undefined) {
+    return 1;
+  }
+  if (va.prerelease !== undefined && vb.prerelease === undefined) {
+    return -1;
+  }
+  if (va.prerelease === undefined && vb.prerelease === undefined) {
+    return 0;
+  }
+  const pa = va.prerelease!;
+  const pb = vb.prerelease!;
+  return pa.localeCompare(pb);
+}
+
+export function isNewer(latestTag: string, currentVersion: string): boolean {
+  if (currentVersion === 'dev') {
+    return false;
+  }
+  return compareVersions(latestTag, currentVersion) > 0;
+}
