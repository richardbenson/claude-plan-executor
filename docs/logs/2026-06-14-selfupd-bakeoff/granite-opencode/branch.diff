+export async function maybePrintUpdateNudge(argv: string[]): Promise<void> {
+  // Skip for update itself and for start
+  if (argv.includes('start') || argv.includes('update')) return;
+  if (CPE_VERSION === 'dev') return;
+  const cfg = readConfig();
+  if (!cfg.update_auto) return;
+  if (!shouldCheck(24)) return;
+  const latest = await fetchLatestTag(2000);
+  writeUpdateState({ last_checked_at: new Date().toISOString(), latest_seen: latest });
+  if (isNewer(latest, CPE_VERSION)) {
+    console.error(`update available: ${latest} — run cpe update`);
+  }
+}
