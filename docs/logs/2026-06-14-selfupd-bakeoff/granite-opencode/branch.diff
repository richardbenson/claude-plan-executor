+++ b/src/update/auto.ts
@@ -0,0 +1,52 @@
+// src/update/auto.ts
+import { activityBus } from '../events/bus.js';
+import { CPE_VERSION } from '../version.js';
+import { fetchLatestTag, isNewer, downloadAndInstall } from '../update/index.js';
+import { writeUpdateState } from '../storage/update-state.js';
+import { interruptiblePause } from '../commands/start.js';
+import { dim, yellow } from '../theme.js';
+
+let installedUpdate: string | null = null;
+
+export function getInstalledUpdate(): string | null {
+  return installedUpdate;
+}
+
+export function subscribeInstalledUpdate(fn: (tag: string) => void): () => void {
+  return activityBus.subscribe('installed-update', fn);
+}
+
+function runCheck(config: { update_auto: boolean }, deps?: { interruptiblePause: (ms: number) => void }) {
+  if (CPE_VERSION === 'dev' || !config.update_auto) return;
+  const pause = deps?.interruptiblePause ?? (ms => new Promise(r => setTimeout(r, ms)));
+  pause(30000).then(() => {
+    try {
+      const latest = fetchLatestTag();
+      if (!latest) return;
+      if (isNewer(latest, CPE_VERSION)) {
+        const result = downloadAndInstall(latest);
+        if (result) {
+          installedUpdate = latest;
+          activityBus.emit({ kind: 'installed-update', tag: latest });
+          writeUpdateState({ installedUpdate: latest });
+          console.error(`[update] New version ${yellow}${latest}${dim} installed; restart to apply`);
+        }
+      }
+    } catch (e) {
+      console.error('[update] failed', e);
+    }
+  });
+}
+
+export function startAutoUpdateLoop(config: { update_auto: boolean }, deps?: { interruptiblePause: (ms: number) => void }) {
+  if (CPE_VERSION === 'dev' || !config.update_auto) return () => {};
+  const pause = deps?.interruptiblePause ?? (ms => new Promise(r => setTimeout(r, ms)));
+  function loop() {
+    pause(6 * 60 * 60 * 1000).then(() => {
+      runCheck(config, deps);
+      loop();
+    });
+  }
+  loop();
+  return () => {};
+}
