+  it('does nothing in dev mode', async () => {
+    process.env.CPE_VERSION = 'dev';
+    const unsub = auto.startAutoUpdateLoop({ update_auto: true });
+    await new Promise(r => setTimeout(r, 100));
+    expect(unsub).toBeInstanceOf(Function);
+    expect(getInstalledUpdate()).toBeNull();
+  });
+
+  it('does nothing when update_auto is false', async () => {
+    process.env.CPE_VERSION = 'stable';
+    const unsub = auto.startAutoUpdateLoop({ update_auto: false });
+    await new Promise(r => setTimeout(r, 100));
+    expect(unsub).toBeInstanceOf(Function);
+    expect(getInstalledUpdate()).toBeNull();
+  });
+
+  it('installs once on a newer tag', async () => {
+    process.env.CPE_VERSION = 'stable';
+    const stubbedFetch = stub({
+      name: 'fetchLatestTag',
+      returns: 'v1.2.3',
+    });
+    const stubbedIsNewer = stub({
+      name: 'isNewer',
+      returns: true,
+    });
+    const stubbedDownload = stub({
+      name: 'downloadAndInstall',
+      returns: true,
+    });
+    const stubbedWrite = stub({
+      name: 'writeUpdateState',
+      returns: undefined,
+    });
+    auto.startAutoUpdateLoop({ update_auto: true }, { interruptiblePause: stub({ name: 'interruptiblePause', returns: Promise.resolve() }) });
+    await new Promise(r => setTimeout(r, 500));
+    expect(getInstalledUpdate()).toBe('v1.2.3');
+    expect(stubbedFetch).toHaveBeenCalledOnce();
+    expect(stubbedIsNewer).toHaveBeenCalledOnce();
+    expect(stubbedDownload).toHaveBeenCalledOnce();
+    expect(stubbedWrite).toHaveBeenCalledOnce();
+    expect(console.error).toHaveBeenCalledWith(expect.stringContaining('[update] New version v1.2.3 installed; restart to apply'));
+  });
+
+  it('retries on a failed install only once', async () => {
+    process.env.CPE_VERSION = 'stable';
+    const stubbedFetch = stub({
+      name: 'fetchLatestTag',
+      returns: 'v1.2.3',
+    });
+    const stubbedIsNewer = stub({
+      name: 'isNewer',
+      returns: true,
+    });
+    const stubbedDownload = stub({
+      name: 'downloadAndInstall',
+      returns: false,
+    });
+    const stubbedWrite = stub({
+      name: 'writeUpdateState',
+      returns: undefined,
+    });
+    auto.startAutoUpdateLoop({ update_auto: true }, { interruptiblePause: stub({ name: 'interruptiblePause', returns: Promise.resolve() }) });
+    await new Promise(r => setTimeout(r, 500));
+    expect(getInstalledUpdate()).toBeNull();
+    expect(stubbedDownload).toHaveBeenCalledOnce();
+    expect(console.error).toHaveBeenCalledWith(expect.stringContaining('[update] failed'));
+  });
+});
