@@ -0,0 +1,25 @@
+export async function updateCommand(opts: { check?: boolean }): Promise<void> {
+  if (CPE_VERSION === 'dev') {
+    console.log('Self-update is disabled for dev builds. Rebuild via scripts/install-local.sh');
+    return;
+  }
+  const latest = await fetchLatestTag();
+  if (opts.check) {
+    console.log(`Current version: ${CPE_VERSION}, latest tag: ${latest}`);
+    if (isNewer(latest, CPE_VERSION)) {
+      console.log('update available – run cpe update');
+    } else {
+      console.log('already up to date');
+    }
+    return;
+  }
+  if (isNewer(latest, CPE_VERSION)) {
+    console.log('Downloading binary (~92 MB)...');
+    await downloadAndInstall(latest);
+    console.log(`updated ${CPE_VERSION} → ${latest}`);
+    console.log('Restart cpe start to run the new version.');
+  } else {
+    console.log(`already up to date (${CPE_VERSION})`);
+  }
+  writeUpdateState({ last_checked_at: new Date().toISOString(), latest_seen: latest });
+}
