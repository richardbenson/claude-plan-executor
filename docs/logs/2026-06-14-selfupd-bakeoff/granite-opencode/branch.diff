+# src/update/__init__.py
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+# Version resolution and comparison utilities
+
+def resolve_version() -> str:
+    """Resolve the current application version from a VERSION file.
+
+    Returns:
+        str: The version string, e.g., "1.2.3".
+    """
+    version_path = Path(__file__).parents[1] / "VERSION"
+    if version_path.is_file():
+        return version_path.read_text().strip()
+    raise FileNotFoundError(f"Version file not found at {version_path}")
+
+
+def compare_versions(current: str, remote: str) -> bool:
+    """Compare current version with a remote version.
+
+    Returns:
+        bool: True if remote version is newer, False otherwise.
+    """
+    def normalize(v: str) -> list:
+        return [int(x) for x in v.split(".")]
+    cur = normalize(current)
+    rem = normalize(remote)
+    for c, r in zip(cur, rem):
+        if c < r:
+            return True
+        elif c > r:
+            return False
+    return False
+
+# Verified atomic binary installation
+
+def install_binary(binary_path: Path, dest: Path) -> None:
+    """Install a binary atomically.
+
+    The installation is performed by moving the binary to the destination
+    path only if the destination does not exist or the move succeeds.
+    """
+    if dest.exists():
+        raise FileExistsError(f"Destination {dest} already exists")
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    # Use rename which is atomic on POSIX systems
+    binary_path.rename(dest)
+
+# Persisted check-state management
+
+def save_check_state(state: dict, path: Path) -> None:
+    """Save check state to a JSON file.
+
+    Args:
+        state (dict): The state dictionary to persist.
+        path (Path): File path where to store the state.
+    """
+    path.parent.mkdir(parents=True, exist_ok=True)
+    json.dump(state, path.open("w"), indent=2)
+
+
+def load_check_state(path: Path) -> dict:
+    """Load check state from a JSON file.
+
+    Args:
+        path (Path): File path from which to load the state.
+
+    Returns:
+        dict: The loaded state dictionary.
+    """
+    if not path.is_file():
+        return {}
+    return json.load(path.open())
+
