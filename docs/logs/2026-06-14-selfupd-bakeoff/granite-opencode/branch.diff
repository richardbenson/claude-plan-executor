+// src/tui/hooks/useInstalledUpdate.ts
+import { useState, useEffect } from "react";
+import { subscribeInstalledUpdate, getInstalledUpdate } from "../update/auto";
+import { yellow } from "../theme";
+
+export function useInstalledUpdate() {
+  const [installedUpdate, setInstalledUpdate] = useState<string | null>(getInstalledUpdate());
+
+  useEffect(() => {
+    const unsubscribe = subscribeInstalledUpdate(tag => {
+      setInstalledUpdate(tag);
+    });
+    return unsubscribe;
+  }, []);
+
+  return installedUpdate;
+}
