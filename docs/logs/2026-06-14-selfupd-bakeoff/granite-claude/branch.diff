diff --git a/scripts/install.sh b/scripts/install.sh
index c2c09cf..5bc68fe 100755
--- a/scripts/install.sh
+++ b/scripts/install.sh
@@ -26,6 +26,43 @@ mkdir -p "$HOME/.local/bin"
 curl -fsSL "$URL" -o "$HOME/.local/bin/cpe"
 chmod +x "$HOME/.local/bin/cpe"
 
+# ---- checksum verification ----
+# Attempt to download SHA256SUMS from the same release asset list
+SHA256SUMS_URL="https://github.com/richardbenson/claude-plan-executor/releases/latest/download/SHA256SUMS"
+TMP_SUMS=$(mktemp)
+
+if curl -fsSL "$SHA256SUMS_URL" -o "$TMP_SUMS"; then
+  # Extract the line matching our ASSET and verify
+  MATCHED=$(grep "${ASSET}$" "$TMP_SUMS")
+  if [[ -n "$MATCHED" ]]; then
+    HASH=$(echo "$MATCHED" | awk '{print $1}')
+    # Use sha256sum if present, otherwise fall back to shasum -a 256 (macOS)
+    if command -v sha256sum >/dev/null; then
+      VERIFY_CMD="sha256sum -c --quiet -"
+    else
+      VERIFY_CMD="shasum -a 256 -c --quiet -"
+    fi
+    printf "%s\t${ASSET}\n" "$HASH" | $VERIFY_CMD "$HOME/.local/bin/cpe"
+    if [[ $? -eq 0 ]]; then
+      echo "Checksum verification passed."
+    else
+      echo "[error] Checksum mismatch for ${ASSET}. Deleting downloaded binary." >&2
+      rm "$HOME/.local/bin/cpe"
+      exit 1
+    fi
+  else
+    echo "[warn] SHA256SUMS file exists but does not contain entry for ${ASSET}. Skipping verification."
+  fi
+else
+  echo "[warn] Failed to download SHA256SUMS; verification skipped."
+fi
+
+# If verification failed or was skipped, ensure we still have a binary
+if [[ ! -x "$HOME/.local/bin/cpe" ]]; then
+  echo "Binary missing after verification attempt. Exiting." >&2
+  exit 1
+fi
+
 echo "Installed: $HOME/.local/bin/cpe"
 
 if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
