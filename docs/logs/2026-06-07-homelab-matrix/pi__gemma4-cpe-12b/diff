+---
+tool: opencode
+description: "Open source code analysis project"
+update_command: "pip install -U opencode"
+check_version_command: "opencode --version | head -n 1"
+health_check:
+  status_cmd: "systemctl is-active opencode || echo 'inactive'"
+  expected_output: "active"
+
+---
+tool: openchamber
+description: "Open source chamber environment tool"
+update_command: "pip install -U openchamber"
+check_version_command: "openchamber --version | head -n 1"
+health_check:
+  status_cmd: "systemctl is-active openchamber || echo 'inactive'"
+  expected_output: "active"
