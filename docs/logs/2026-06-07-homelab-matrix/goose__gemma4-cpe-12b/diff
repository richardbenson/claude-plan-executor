+#!/bin/bash
+set -euo pipefail
+
+# Configuration
+STATE_FILE="/var/lib/opencode/maintenance/state.json"
+LOG_FILE="/var/log/update_manager.log"
+mkdir -p "$(dirname "$STATE_FILE")"
+touch "$LOG_FILE"
+
+echo "--- Update Started: $(date) ---" | tee -a "$LOG_FILE"
+
+# Helper function to log and update state JSON naturally 
+# (Using jq for robust JSON manipulation)
+update_state() {
+  local key="$1"
+  local value="$2"
+  if [[ -f "$STATE_FILE" ]]; then
+    jq --arg k "$key" --arg v "\$v" '.[$k] = $v' "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"
+  else
+    echo "{}" | jq --arg k "$key" --arg v "\$v" '.[$k] = $v' > "$STATE_FILE"
+  fi
+}
+
+# 1. APT Updates
+echo "Running apt updates..." | tee -a "$LOG_FILE"
+sudo apt-get update && sudo apt-get upgrade -y >> "$LOG_FILE" 2>&1
+update_state "apt_last_success" "$(date +%s)"
+
+# 2. NPM Global Updates (opencode-ai, openchamber)
+echo "Checking and updating npm globals..." | tee -a "$LOG_FILE"
+for pkg in opencode-ai openchamber; do
+  CURRENT_VERSION=$(npm list -g --depth=0 | grep $pkg | awk '{print $2}' || echo "unknown")
+  LATEST_VERSION=$(npm view $@ version)
+  
+  if [[ "$CURRENT_VERSION" != "$LATEST_VERSION" ]]; then
+    echo "Updating $pkg: $CURRENT_VERSION -> $LATEST_VERSION" | tee -a "$LOG_FILE"
+    sudo npm install -g "$pkg"@latest >> "$LOG_FILE" 2>&1 && \
+    update_state "$pkg" "$LATEST_VERSION" || echo "Failed to update $pkg" >&2
+  else
+    echo "$pkg is up to date ($CURRENT_VERSION)" | tee -a "$LOG_FILE"
+  fi
+done
+
+# 3. Binary Downloads (Manual logic for gh, tea)
+# This section can be expanded as new binaries are added.
+# We want these to update if the available release version in our script beats current state.
+echo "Checking manual binary releases..." | tee -a "$LOG_FILE"
+
+check_github_release() {
+  local name="$1"
+  local download_url_template="$2" # e.g., https://github.com/cli/cli/releases/download/%(version)s/gh_%(version)_linux_amd64.tar.gz
+  local bin_dest="/usr/local/bin/$name"
+
+  # Note: Real automation here would require a complex script to fetch latest tags 
+  # From the GitHub API and parse them correctly with regex for different filenames.
+  # For now, we will keep binary updates manual in Ansible as they are high-risk / unique file names.
+}
+
+echo "--- Update Finished: $(date) ---" | tee -a "$LOG_FILE"
