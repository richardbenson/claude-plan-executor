+---
+# Update Procedure for opencode VM tools
+
+# Designed to be run from the Ansible controller (localhost) and applied to target VMs.
+# It uses version definitions from tools.yml as a "source of truth".
+
+- name: Update opencode tools
+  hosts: opencode_vms
+  become: true
+  gather_facts: false
+
+  pre_tasks:
+    - name: Load tool configuration locally
+      ansible.builtin.include_vars:
+        file: "{{ item }}"
+      with_items:
+        - ../group_vars/opencode_vms/tools.yml
+        - ../group_var/opencode_vms/updatable_tools.yml # Wait, checking directory... it's group_vars/
+      delegate_to: localhost
+    - name: Check if vars loaded (debug)
+      ansible.builtin.debug:
+        msg: "Loaded gh version {{ hostvars[inventory_hostname].gh_version | default('NOT LOADED') }}"
+      delegate_to: localhost
+
+  tasks:
+    # -- GitHub CLI (gh) --------------------------------------------------------
+
+    - name: Update gh binary via downloading and extraction
+      ansible.builtin.unarchive:
+        src: "{{ tool_config.gh_dl_url_template | replace('{version}', tool_config.gh_version) }}"
+        dest: /tmp/gh_{{ tool_config.gh_version }}
+        remote_src: true
+      when: tool_config.gh_version is defined
+
+    - name: Install gh binary
+      ansible.builtin.copy:
+        src: /tmp/gh_{{ tool_config.gh_version }}/bin/gh
+        dest: /usr/local/bin/gh
+        mode: "0755"
+        remote_src: true
+      when: tool_config.gh_version is defined
+
+    # -- Gitea CLI (tea) ------------------------------------------
+
+    - name: Update tea binary via downloading
+      ansible.builtin.get_url:
+        url: "{{ tool_config.tea_dl_url_template | replace('{version}', tool_config.tea_version) }}"
+        dest: /usr/local/bin/tea
+        mode: "0755"
+        remote_src: true
+      when: tool_config.tea_version is defined
+
+    # -- RTK ------------------------------------------------------
+
+    - name: Update rtk binary via downloading and extraction
+      ansible.builtin.unarchive:
+         src: "{{ tool_config.rtk_dl_url_template | replace('{version}', tool_config.rtk_version) }}"
+         dest: /tmp/rtk_{{ tool_config.rtk_version }}
+         remote_src: true
+      when: tool_config.rtk_version is defined
+
+    - name: Install rtk binary
+      ansible.builtin.copy:
+        src: /tmp/rtk_{{ tool_config.rtk_version }}/bin/rtk
+        dest: /usr/local/bin/rtk
+        mode: "0755"
+        remote_src: true
+      when: tool_config.rtk_version is defined
+
+    # -- npm packages (openchamber) -------------------------------
+
+    - name: Update openchamber via npm
+      ansible.builtin.shell:
+        cmd: "npm install -g https://github.com/openchamber/openchamber/releases/download/v{{ tool_config.openchamber_version }}/openchamber-web-{{ tool_config.openchamber_version }}.tgz"
+        creates: /usr/local/bin/openchamber
+      when: tool_config.openchamber_version is defined
+
+    # -- npm packages (opencode) ----------------------------------
+
+    - name: Update opencode via npm
+      ansible.builtin.shell:
+        cmd: "npm install -g {{ tool_config.opencode_package }}"
+        creates: /usr/local/bin/opencode
+      when: tool_config.opencode_package is defined
+
+    # -- Cleanup -----------------------------------------------
+
+    - name: Clean up temporary installation artifacts
+      ansible.builtin.file:
+        path: "{{ item }}"
+        state: none
+      loop:
+        - "/tmp/gh_{{ tool_config.gh_version | default('none') }}"
+        - "/tmp/rtk_{{ tool_config.rtk_version | default('none') }}"
+      when: tool_config is defined
+
+    # Finalizing configuration ---------------------------
+
+    - name: Reload systemd and restart openchamber
+      ansible.builtin.systemd:
+        name: openchamber
+        state: restarted
+        daemon_reload: true
+      when: tool_config.openchamber_version is defined
