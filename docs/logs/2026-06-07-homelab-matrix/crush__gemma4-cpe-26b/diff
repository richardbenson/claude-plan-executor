+++ b/ansible/group_vars/opencode_vms/tools.yml
@@ -0,0 +1,28 @@
+---
+# Tool version tracking for opencode VM
+
+# These are used by provision-opencode.yml/updatable_tools.yml
+
+# -- GitHub CLI (gh) --------------------------------------------------------
+gh_version: "2.93.0"
+gh_dl_url_template: "https://github.com/cli/cli/releases/download/v{version}/gh_{version}_linux_amd64.tar.gz"
+
+# -- Gitea CLI (tea) --------------------------------------------------------
+tea_version: "0.14.1"
+tea_dl_url_template: "https://gitea.com/gitea/tea/releases/download/v{version}/tea-{version}-linux-amd64"
+
+# -- RTK --------------------------------------------------------------------
+rtk_version: "0.42.0"
+rtk_dl_url_template: "https://github.com/rtk-ai/rtk/releases/download/v{version}/rtk-x86_64-unknown-linux-musl.tar.gz"
+
+# -- openchamber (npm) ------------------------------------------------------
+openchamber_version: "1.11.7"
+openchamber_dl_url_template: "https://github.com/openchamber/openchamber/releases/download/v{version}/openchamber-web-{version}.tgz"
+
+# -- opencode (npm) ---------------------------------------------------------
+# Note: npm install -g handles finding the latest, but we can track it here if needed
+opencode_package: "opencode-ai"
+
+# -- Node.js (apt/nodesource) -----------------------------------------------
+nodejs_major_version: "22"
+
diff --git a/ansible/group_vars/opencode_vms/updatable_tools.yml b/ansible/group_vars/opencode_vms/updatable_tools.yml
