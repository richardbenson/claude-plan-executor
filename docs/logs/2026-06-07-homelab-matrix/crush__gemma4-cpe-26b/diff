@@ -0,0 +1,36 @@
+---
+# Import tool versions from tools.yml
+
+import_vars:
+  - tools.yml
+
+# Configuration for the update procedure
+update_check_enabled: true
+updatable_tools:
+  - name: gh
+    type: binary
+    version_var: gh_version
+    dl_template: gh_dl_url_template
+    extract: true
+    dest: /usr/local/bin/gh
+  - name: tea
+    type: binary
+    version_var: tea_version
+    dl_template: tea_dl_url_template
+    extract: false
+    dest: /usr/local/bin/tea
+  - name: rtk
+    type: binary
+    version_var: rtk_version
+    dl_template: rtk_dl_url_template
+    extract: true
+    dest: /usr/local/bin/rtk
+  - name: openchamber
+    type: npm
+    version_var: openchamber_version
+    dl_template: openchamber_dl_url_template
+    extract: false
+    npm_install_cmd: "npm install -g https://github.com/openchamber/openchamber/releases/download/v{version}/openchamber-web-{version}.tgz"
+  - name: opencode
+    type: npm
+    package_name: opencode_package
