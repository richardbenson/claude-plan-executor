---
- name: Ensure update manager configuration exists
  copy:
    dest: /etc/homelab/tools_metadata.json
    content: "{{ lookup('file', 'files/tools_metadata.json') }}"

- name: Create state directory
  file:
    path: /var/lib/homelab
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Deploy update manager script
  copy:
    dest: /usr/local/bin/update_manager.py
    content: "{{ lookup('file', 'files/update_manager.py') }}"
    mode: '0755'

- name: Create systemd service for update manager
  template:
    src: vm_updates.service.j2
    dest: /etc/systemd/system/vm_updates.service

- name: Enable and start update manager timer
  systemd:
    name: vm_updates.timer
    enabled: yes
    state: started
