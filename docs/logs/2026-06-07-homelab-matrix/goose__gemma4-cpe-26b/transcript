---
# Provisions opencode01: installs all tools, configures opencode.json,
# authenticates VCS CLIs, and starts the openchamber systemd service.
#
# Usage (run from ansible/):
#   ansible-playbook playbooks/provision-opencode.yml --ask-vault-pass
#
# Idempotent: safe to re-run. Re-authentication tasks always re-run (changed_when: true).

- name: Provision opencode VM
  hosts: opencode_vms
  become: true
  gather_facts: false

  handlers:
    - name: Reload systemd and restart openchamber
      ansible.builtin.systemd:
        name: openchamber
        state: restarted
        daemon_reload: true

  tasks:

    # -- System packages ------------------------------------------------------

    - name: Install system packages
      ansible.builtin.apt:
        name:
          - acl
          - curl
          - git
          - jq
          - unzip
          - ca-certificates
          - gnupg
          - lsb-release
        state: present
        update_cache: true
      environment:
        DEBIAN_FRONTEND: noninteractive

    # -- Node.js 22 -----------------------------------------------------------

    - name: Download NodeSource GPG key
      ansible.builtin.get_url:
        url: https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key
        dest: /tmp/nodesource.gpg.key
        mode: "0644"

    - name: Dearmor NodeSource GPG key
      ansible.builtin.shell:
        cmd: gpg --dearmor < /tmp/nodesource.gpg.key > /usr/share/keyrings/nodesource.gpg
        creates: /usr/share/keyrings/nodesource.gpg

    - name: Add NodeSource apt repository
      ansible.builtin.apt_repository:
        repo: "deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main"
        state: present
        filename: nodesource

    - name: Install Node.js
      ansible.builtin.apt:
        name: nodejs
        state: present
        update_cache: true
      environment:
        DEBIAN_FRONTEND: noninteractive

    # -- opencode -------------------------------------------------------------

    - name: Install opencode globally via npm
      ansible.builtin.shell:
        cmd: npm install -g opencode-ai
        creates: /usr/local/bin/opencode

    # -- openchamber ----------------------------------------------------------

    - name: Install openchamber via npm (GitHub release tgz)
      ansible.builtin.shell:
        cmd: >
          npm install -g
          https://github.com/openchamber/openchamber/releases/download/v1.11.7/openchamber-web-1.11.7.tgz
        creates: /usr/local/bin/openchamber

    # -- gh CLI ---------------------------------------------------------------

    - name: Download gh CLI v2.93.0
      ansible.builtin.unarchive:
        src: https://github.com/cli/cli/releases/download/v2.93.0/gh_2.93.0_linux_amd64.tar.gz
        dest: /tmp
        remote_src: true
        creates: /tmp/gh_2.93.0_linux_amd64

    - name: Install gh binary
      ansible.builtin.copy:
        src: /tmp/gh_2.93.0_linux_amd64/bin/gh
        dest: /usr/local/bin/gh
        mode: "0755"
        remote_src: true

    # -- tea CLI --------------------------------------------------------------

    - name: Install tea CLI v0.14.1
      ansible.builtin.get_url:
        url: https://gitea.com/gitea/tea/releases/download/v0.14.1/tea-0.14.1-linux-amd64
        dest: /usr/local/bin/tea
        mode: "0755"

    # -- rtk ------------------------------------------------------------------

    - name: Download rtk v0.42.0 (musl)
      ansible.builtin.unarchive:
        src: https://github.com/rtk-ai/rtk/releases/download/v0.42.0/rtk-x86_64-unknown-linux-musl.tar.gz
        dest: /tmp
        remote_src: true
        creates: /tmp/rtk

    - name: Install rtk binary
      ansible.builtin.copy:
        src: /tmp/rtk
        dest: /usr/local/bin/rtk
        mode: "0755"
        remote_src: true

    # -- opencode system user -------------------------------------------------

    - name: Create opencode system user
      ansible.builtin.user:
        name: opencode
        system: true
        create_home: true
        shell: /bin/bash

    # -- bun (as opencode user) ------------------------------------------------

    - name: Install bun as opencode user
      ansible.builtin.shell:
        cmd: curl -fsSL https://bun.sh/install | bash
        creates: /home/opencode/.bun/bin/bun
      become_user: opencode
      environment:
        HOME: /home/opencode

    # -- opencode config -------------------------------------------------------

    - name: Ensure opencode config directory exists
      ansible.builtin.file:
        path: /home/opencode/.config/opencode
        state: directory
        owner: opencode
        group: opencode
        mode: "0755"

    - name: Template opencode.json
      ansible.builtin.template:
        src: ../templates/opencode.json.j2
        dest: /home/opencode/.config/opencode/opencode.json
        owner: opencode
        group: opencode
        mode: "0644"
      notify: Reload systemd and restart openchamber

    # -- RTK plugin ------------------------------------------------------------

    - name: Initialize RTK opencode plugin
      ansible.builtin.shell:
        cmd: /usr/local/bin/rtk init -g --opencode
        creates: /home/opencode/.config/opencode/plugins/rtk.ts
      become_user: opencode
      environment:
        HOME: /home/opencode
        PATH: /usr/local/bin:/usr/bin:/bin
      async: 30
      poll: 5

    # -- Caveman plugin --------------------------------------------------------

    - name: Install Caveman plugin
      ansible.builtin.shell:
        cmd: /home/opencode/.bun/bin/bunx github:JuliusBrussee/caveman --only opencode || true
        creates: /home/opencode/.config/opencode/plugins/caveman
      become_user: opencode
      environment:
        HOME: /home/opencode

    # -- Caveman default mode --------------------------------------------------

    - name: Ensure caveman config directory exists
      ansible.builtin.file:
        path: /home/opencode/.config/caveman
        state: directory
        owner: opencode
        group: opencode
        mode: "0755"

    - name: Set caveman default mode to off (opt-in per session via /caveman)
      ansible.builtin.copy:
        content: '{"defaultMode":"off"}'
        dest: /home/opencode/.config/caveman/config.json
        owner: opencode
        group: opencode
        mode: "0644"

    # -- VCS CLI authentication ------------------------------------------------

    - name: Authenticate gh CLI
      ansible.builtin.shell:
        cmd: "echo '{{ opencode_github_token }}' | gh auth login --with-token"
      become_user: opencode
      environment:
        HOME: /home/opencode
        PATH: /usr/local/bin:/usr/bin:/bin
      no_log: true
      changed_when: true

    - name: Authenticate tea CLI (Gitea)
      ansible.builtin.shell:
        cmd: |
          tea login delete homelab 2>/dev/null || true
          tea login add --name homelab \
            --url https://{{ opencode_gitea_hostname }} \
            --token "{{ opencode_gitea_token }}"
      become_user: opencode
      environment:
        HOME: /home/opencode
        PATH: /usr/local/bin:/usr/bin:/bin
      no_log: true
      changed_when: true

    # -- Git credentials ------------------------------------------------------

    - name: Template ~/.git-credentials
      ansible.builtin.template:
        src: ../templates/git-credentials.j2
        dest: /home/opencode/.git-credentials
        owner: opencode
        group: opencode
        mode: "0600"
      no_log: true

    - name: Configure git credential helper
      community.general.git_config:
        name: credential.helper
        scope: global
        value: store
      become_user: opencode
      environment:
        HOME: /home/opencode

    # -- openchamber systemd service -------------------------------------------

    - name: Install openchamber systemd unit
      ansible.builtin.template:
        src: ../templates/openchamber.service.j2
        dest: /etc/systemd/system/openchamber.service
        owner: root
        group: root
        mode: "0644"
      notify: Reload systemd and restart openchamber

    - name: Enable and start openchamber service
      ansible.builtin.systemd:
        name: openchamber
        enabled: true
        state: started
        daemon_reload: true
