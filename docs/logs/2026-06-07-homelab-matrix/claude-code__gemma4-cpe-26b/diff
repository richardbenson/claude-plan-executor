+---
+# ansible/vars/tools_registry.yml
+
+# The source of truth for tool versions and installation methods.
+# This is used by the 'tool_manager' role to detect updates and perform installations.
+
+tools:
+  - name: "gh"
+    check_url: "https://api.github.com/repos/cli/cli/releases/latest"
+    current_version: "2.93.0"
+    type: "github"
+    asset_pattern: "gh_.*_linux_amd64.tar.gz"
+
+  - name: "tea"
+    check_url: "https://gitea.com/api/v1/repos/gitea/tea/releases/latest"
+    current_version: "0.14.1"
+    type: "github"
+    asset_pattern: "tea-.*-linux-amd64"
+
+  - name: "rtk"
+    check_url: "https://api.github.com/repos/rtk-ai/rtk/releases/latest"
+    current_version: "0.42.0"
+    type: "github"
+    asset_pattern: "rtk-.*-x86_64-unknown-linux-musl.tar.gz"
+
+  - name: "openchamber"
+    check_url: "https://api.github.com/repos/openint/open_chamber/releases/latest"
+    current_version: "1.11.7"
+    type: "github"
+    asset_pattern: "openchamber-web-.*\.tgz"
+
+  - name: "opencode-ai"
+    type: "npm"
