+# Example of how to use the version manifest in your existing Ansible roles.
+# This task demonstrates pulling a specific version defined in our manifest.
+
+- name: Load version configuration
+  include_vars:
+    file: "../../../infrastructure/updates/versions.yaml"
+    name: version_config
+
+- name: Ensure directory for tools exists
+  file:
+    path: "/opt/apps"
+    state: directory
+
+- name: Download Opencode {{ version_config.tools.opencode.target_version }}
+  get_url:
+    url: "https://github.com/{{ version_config.tools.opencode.repository }}/releases/download/{{ version_config.tools.opencode.target_version }}/opencode.tar.gz"
+    dest: "/tmp/opencode.tar.gz"
+
+- name: Extract Opencode
+  unarchive:
+    src: "/tmp/opencode.tar.gz"
+    dest: "/opt/apps/opencode"
+    remote_src: yes
+
+- name: Restart Opencode service
+  systemd:
+    name: opencode
+    state: restarted
+    enabled: yes
