```python
#!/usr/bin/env python3
import requests
import sys

# Configuration for services to check
SERVICES = {
    "opencode": "http://<vm_ip>:8080/api/health",
    "openchamber": "http://<vm_ip>:9090/status"
}

def check_service(name, url):
    try:
        print(f"Checking {name} at {url}...")
        response = requests.get(url, timeout=5)
        if response.status_code == 200:
            print(f"  [OK] {name} is healthy.")
            return True
        else:
            print(f"  [FAIL] {name} returned status {response.status_code}")
            return False
    except Exception as e:
        print(f"  [ERROR] Could not connect to {name}: {e}")
        return False

def main():
    all_passed = True
    for name, url in SERVICES.items():
        if not check_service(name, url):
            all_passed = False
    
    if not all_passed:
        print("\nHealth check FAILED. Manual intervention or rollback required.")
        sys/exit(1)
    else:
        print("\nAll services passed health checks.")
        sys.exit(0)

if __name__ == "__main__":
    main()
