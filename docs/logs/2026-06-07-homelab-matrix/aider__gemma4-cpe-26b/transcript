scripts/update_checker.py
```python
#!/usr/bin/env python3
import yaml
import requests
import datetime
import os
import sys

# Path to the version manifest
MANIFEST_PATH = "infrastructure/updates/versions.yaml"

def get_latest_github_tag(repo):
    """Queries GitHub API for the latest release tag."""
    url = f"https://api.github.com/repos/{repo}/releases/latest"
    try:
        response = requests.get(url, timeout=10)
        response.raise_for_status()
        return response.json()['tag_name']
    except Exception as e:
        print(f"Error checking {repo}: {e}")
        return None

def update_manifest():
    if not os.path.exists(MANIFEST_PATH):
        print(f"Error: Manifest not found at {MANIFEST_PATH}")
        sys.exit(1)

    with open(MANIFEST_PATH, 'r') as f:
        data = yaml.safe_load(f)

    changes_detected = False
    tools = data.get('tools', {})

    for tool_name, info in tools.items():
        repo = info.get('repository')
        if not repo:
arg_error = f"No repository defined for {tool_name}"
            print(arg_error)
            continue

        latest_tag = get_latest_github_tag(repo)
        if not latest_tag:
            continue

        current_target = info.get('target_version')

        if latest_tag != current_target:
            print(f"Update found for {tool_name}: {current_target} -> {latest_tag}")
            # Move current target to last_known_good before updating
            info['last_known_good'] = current_target
            info['target_version'] = latest_tag
            changes_detected = True

    if changes_detected:
        data['metadata']['last_update_check'] = datetime.datetime.now().isoformat()
        with open(MANIFEST_PATH, 'w') as f:
            yaml.dump(data, f, default_flow_style=False)
        print("Manifest updated successfully.")
        # In a real CI environment, you would trigger your Terraform/Ansible pipeline here.
        return True
    else:
        print("No updates found.")
        return False

if __name__ == "__main__":
    update_manifest()
```

