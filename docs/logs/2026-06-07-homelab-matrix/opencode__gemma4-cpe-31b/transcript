 mode: \"0644\"\n49: \n50:     - name: Dearmor NodeSource GPG key\n51:       ansible.builtin.shell:\n52:         cmd: gpg --dearmor < /tmp/nodesource.gpg.key > /usr/share/keyrings/nodesource.gpg\n53:         creates: /usr/share/keyrings/nodesource.gpg\n54: \n55:     - name: Add NodeSource apt repository\n56:       ansible.builtin.apt_repository:\n57:         repo: \"deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main\"\n58:         state: present\n59:         filename: nodesource\n60: \n61:     - name: Install Node.js\n62:       ansible.builtin.apt:\n63:         name: nodejs\n64:         state: present\n65:         update_cache: true\n66:       environment:\n67:         DEBIAN_FRONTEND: noninteractive\n68: \n69:     # -- opencode -------------------------------------------------------------\n70: \n71:     - name: Install opencode globally via npm\n72:       ansible.builtin.shell:\n73:         cmd: npm install -g opencode-ai\n74:         creates: /usr/local/bin/opencode\n75: \n76:     # -- openchamber ----------------------------------------------------------\n77: \n78:     - name: Install openchamber via npm (GitHub release tgz)\n79:       ansible.builtin.shell:\n80:         cmd: >\n81:           npm install -g\n82:           https://github.com/openchamber/openchamber/releases/download/v1.11.7/openchamber-web-1.11.7.tgz\n83:         creates: /usr/local/bin/openchamber\n84: \n85:     # -- gh CLI ---------------------------------------------------------------\n86: \n87:     - name: Download gh CLI v2.93.0\n88:       ansible.builtin.unarchive:\n89:         src: https://github.com/cli/cli/releases/download/v2.93.0/gh_2.93.0_linux_amd64.tar.gz\n90:         dest: /tmp\n91:         remote_src: true\n92:         creates: /tmp/gh_2.93.0_linux_amd64\n93: \n94:     - name: Install gh binary\n95:       ansible.builtin.copy:\n96:         src: /tmp/gh_2.93.0_linux_amd64/bin/gh\n97:         dest: /usr/local/bin/gh\n98:         mode