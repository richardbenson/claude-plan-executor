{"type":"tool_use","timestamp":1780836944123,"sessionID":"ses_15dfc534affequNGotWgLedLAm","part":{"type":"tool","tool":"write","callID":"call_z6rf7u53","state":{"status":"completed","input":{"content":"#!/bin/bash\nset -e\n\nLOG_FILE=\"/var/log/tool-updates.json\"\nTIMESTAMP=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\n\n# Helper to get latest GitHub release tag\nget_latest_tag() {\n    local repo=$1\n    curl -s \"https://api.github.com/repos/${repo}/releases/latest\" | jq -r '.tag_name'\n}\n\nlog_update() {\n    local tool=$1\n    local old_version=$2\n    local new_version=$3\n    echo \"Updating ${tool}: ${old_version} -> ${new_version}\"\n    # Append to JSON log: simple line-delimited JSON for easy parsing/appending\n    printf '{\"timestamp\": \"%s\", \"tool\": \"%s\", \"from\": \"%s\", \"to\": \"%s\"}\\n' \\\n        \"$TIMESTAMP\" \"$tool\" \"$old_version\" \"$new_version\" >> \"$LOG_FILE\"\n}\n\n# 1. System Updates (Apt)\necho \"Running apt-get update and upgrade...\"\napt-get update -y && apt-get upgrade -y\n\n# 2. Node modules / Global NPM tools (opencode, openchamber)\n# opencode is updated via npm install -g which always gets latest unless pinned\necho \"Updating opencode...\"\nnpm install -g opencode-ai@latest\n\n# Openchamber is installed from a tgz release. We need the latest tag.\nOC_REPO=\"openchamber/openchamber\"\nOC_LATEST=$(get_latest_tag \"$OC_REPO\")\nOC_CURRENT=$(openchamber --version 2>/dev/null || echo \"unknown\")\n\nif [ \"$OC_LATEST\" != \"$OC_CURRENT\" ]; then\n    # The filename pattern seems to be openchamber-web-${TAG}.tgz (removing 'v' from tag)\n    VERSION_NUM=${OC_LATEST#v}\n    URL=\"https://github.com/${OC_REPO}/releases/download/${OC_LATEST}/openchamber-web-${VERSION_NUM}.tgz\"\n    npm install -g \"$URL\"\n    log_update \"openchamber\" \"$OC_CURRENT\" \"$OC_LATEST\"\nfi\n\n# 3. GH CLI\nGH_REPO=\"cli/cli\"\nGH_LATEST=$(get_latest_tag \"$GH_REPO\")\nGH_CURRENT=$(gh --version | head -n1 | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' || echo \"unknown\")\n\nif [ \"$GH_LATEST\" != \"v${GH_CURRENT}\" ]; then\n    VERSION_NUM=${GH_LATEST#v}\n    URL=\"https://github.com/${GH_REPO}/releases/download/${GH_LATEST}/gh_${VERSION_NUM}_linux_amd64.tar.gz\"\n    curl -sL \"$URL\" | tar -xz -C /tmp gh_${VERSION_NUM}_linux_amd64\n    cp \"/tmp/gh_${VERSION_NUM}_linux_amd64/bin/gh\" /usr/local/bin/gh\n    rm -rf \"/tmp/gh_${VERSION_NUM}_linux_amd64\"\n    log_update \"gh\" \"$GH_CURRENT\" \"$GH_LATEST\"\nfi\n\n# 4. Tea CLI\nTEA_REPO=\"gitea/tea\"\nTEA_LATEST=$(get_latest_tag \"$TEA_REPO\")\nTEA_CURRENT=$(tea --version | head -n1 | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' || echo \"unknown\")\n\nif [ \"$TEA_LATEST\" != \"v${TEA_CURRENT}\" ]; then\n    VERSION_NUM=${TEA_LATEST#v}\n    URL=\"https://gitea.com/${TEA_REPO}/releases/download/${TEA_LATEST}/tea-${VERSION_NUM}-linux-amd64\"\n    curl -sL \"$URL\" -o /usr/local/bin/tea\n    chmod +x /usr/local/bin/tea\n    log_update \"tea\" \"$TEA_CURRENT\" \"$TEA_LATEST\"\nfi\n\n# 5. RTK\nRTK_REPO=\"rtk-ai/rtk\"\nRTK_LATEST=$(get_latest_tag \"$RTK_REPO\")\nRTK_CURRENT=$(rtk --version | head -n1 | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' || echo \"unknown\")\n\nif [ \"$RTK_LATEST\" != \"v${RTK_CURRENT}\" ]; then\n    VERSION_NUM=${RTK_LATEST#v}\n    URL=\"https://github.com/${RTK_REPO}/releases/download/${RTK_LATEST}/rtk-x86_64-unknown-linux-musl.tar.gz\"\n    curl -sL \"$URL\" | tar -xz -C /tmp rtk\n    cp \"/tmp/rtk\" /usr/local/bin/rtk\n    chmod +x /usr/local/bin/rtk\n    rm -rf \"/tmp/rtk\"\n    log_update \"rtk\" \"$RTK_CURRENT\" \"$RTK_LATEST\"\nfi\n\n# 6. Bun (Self-updating)\necho \"Updating bun...\"\nsu - opencode -c \"curl -fsSL https://bun.sh/install | bash\"\n\n# Restart openchamber to pick up updates if necessary\nsystemctl restart openchamber || true\n\necho \"Update process completed at $TIMESTAMP\"\n","filePath":"/tmp/update-tools.sh"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/tmp/update-tools.sh","exists":false,"truncated":false},"titl