+---
+# Playbook to update tools in the homelab with health checks and version tracking.
+# This playbook is designed to be run periodically (e.g., via cron).
+
+- name: Update Homlab Tools
+  hosts: opencode_vms
+  become: true
+  vars:
+    version_registry_path: "/var/lib/homelab/versions.json"
+    tools:
+      - name: "opencode"
+        update_cmd: "npm install -g opencode-ai"
+        health_check_cmd: "opencode --version"
+        get_version_cmd: "npm view opencode-ai version"
+
+      - name: "openchamber"
+        # We use a shell script on the target to find the latest release URL and install it.
+        update_cmd: >
+          VERSION=$(curl -s https://api.github.com/repos/openchamber/openchamber/releases/latest | jq -r .tag_name | sed 's/^v//') &&
+          npm install -g "https://github.com/openchamber/openchamber/releases/download/v$VERSION/openchamber-web-$VERSION.tgz"
+        health_check_cmd: "openchamber --version"
+        get_version_cmd: "curl -s https://api.github.com/repos/openchamber/openchamber/releases/latest | jq -r .tag_name | sed 's/^v//'"
+
+      - name: "gh-cli"
+        update_cmd: >
+          VERSION=$(curl -s https://api.github.com/repos/cli/cli/releases/latest | jq -r .tag_name | sed 's/^v//') &&
+          mkdir -p /tmp/gh_$VERSION_linux_amd64 &&
+          curl -L "https://github.com/cli/cli/releases/download/v$VERSION/gh_$VERSION_linux_amd64.tar.gz" | tar -xz -C /tmp/gh_$VERSION_linux_amd64 --strip-components=1 &&
+          cp /tmp/gh_$VERSION_linux_amd64/bin/gh /usr/local/bin/gh
+        health_check_cmd: "gh --version"
+        get_version_cmd: "curl -s https://api.github.com/repos/cli/cli/releases/latest | jq -r .tag_name | sed 's/^v//'"
+
+  tasks:
+    - name: Ensure version registry directory exists
+      ansible.builtin.file:
+        path: "{{ version_registry_path | dirname }}"
+        state: directory
+        mode: '0755'
+
+    - name: Initialize version registry if not exists
+      ansible.builtin.copy:
+        content: "{}"
+        dest: "{{ version_registry_path }}"
+        force: false
+
+    - name: Update tools loop
+      include_tasks: roles/tool_manager/tasks/update_tool.yml
+      loop: "{{ tools }}"
+      loop_control:
+        loop_var: tool
