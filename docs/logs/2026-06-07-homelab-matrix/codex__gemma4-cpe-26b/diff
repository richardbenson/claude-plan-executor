new file mode 100644
index 0000000..128c0b7
--- /dev/null
+++ b/ansible/playbooks/roles/tool_manager/tasks/update_tool.yml
@@ -0,0 +1,60 @@
+---
+# Task to update a single tool
+
+- name: Get current version of {{ tool.name }} from registry
+  ansible.builtin.shell: |
+    jq -r '.["{{ tool.name }}"].version // empty' {{ version_registry_path }}
+  register: current_reg_raw
+  changed_when: false
+
+- name: Set current version variable
+  ansible.builtin.set_fact:
+    current_tool_version: "{{ current_reg_raw.stdout | trim }}"
+
+- name: Get latest version for {{ tool.name }} using {{ tool.get_version_cmd }}
+  ansible.builtin.shell: "{{ tool.get_version_cmd }}"
+  register: latest_ver_raw
+  changed_when: false
+
+- name: Set latest version variable
+  ansible.builtin.set_fact:
+    latest_tool_version: "{{ latest_ver_raw.stdout | trim }}"
+
+- name: Check if update is needed for {{ tool.name }}
+  ansible.builtin.set_fact:
+    needs_update: >
+      {{ (current_tool_version == '' or current_tool_version == 'none') and latest_tool_version != '' 
+         or (current_tool_version != latest_tool_version and latest_tool_version != '') }}
+
+- name: Perform update for {{ tool.name }}
+  when: needs_update
+  block:
+    - name: Run update command for {{ tool.name }}
+      ansible.builtin.shell: "{{ tool.update_cmd }}"
+      register: update_result
+
+    - name: Verify health of {{ tool.name }} after update
+      ansible.builtin.shell: "{{ tool.health_check_cmd }}"
+      register: health_check_result
+      failed_when: false
+
+    - name: Handle successful update
+      ansible.builtin.shell: |
+        jq --arg name "{{ tool.name }}"            --arg ver "{{ latest_tool_version }}"            '.[] = {"version": , "status": "ok", "updated_at": "'2026-06-08T08:28:41Z'"}'            {{ version_registry_path }} > {{ version_registry_path }}.tmp && mv {{ version_registry_path }}.tmp {{ version_registry_path }}
+      when: health_check_result.rc == 0
+
+    - name: Handle failed update (revert/log)
+      ansible.builtin.shell: |
+        jq --arg name "{{ tool.name }}"            --arg ver "{{ current_tool_version }}"            '.[] = {"version": , "status": "failed", "error": "Health check failed after update"}'            {{ version_registry_path }} > {{ version_registry_path }}.tmp && mv {{ version_registry_path }}.tmp {{ version_registry_path }}
+      when: health_check_result.rc != 0
+
+    - name: Notify user of failure (via stderr)
+      ansible.builtin.fail:
+        msg: "Update failed for {{ tool.name }}. Please check the registry and investigate."
+      when: health_check_result.rc != 0
+
+- name: Handle first time registration if no update was performed but version is missing
+  when: (current_tool_version == '' or current_tool_version == 'none') and not needs_update
+  ansible.builtin.shell: |
+    jq --arg name "{{ tool.name }}"        --arg ver "{{ latest_tool_version }}"        '.[] = {"version": , "status": "ok", "updated_at": "'2026-06-08T08:28:41Z'"}'        {{ version_registry_path }} > {{ version_registry_path }}.tmp && mv {{ version_registry_path }}.tmp {{ version_registry_path }}
+  when: latest_tool_version != ""
diff --git a/ansible/playbooks/update-tools.yml b/ansible/playbooks/update-tools.yml
