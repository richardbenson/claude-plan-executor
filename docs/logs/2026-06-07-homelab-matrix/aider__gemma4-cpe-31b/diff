+#!/bin/bash
+
+# Configuration
+LOG_FILE="/var/log/homelab_updates.log"
+VERSION_SNAPSHOT="/opt/homelab/versions_last_known.txt"
+ANSIBLE_PLAYBOOK="ansible/playbooks/maintenance.yml"
+INVENTORY="ansible/inventory.ini"
+
+echo "[$(date)] Starting automated update sequence..." >> "$LOG_FILE"
+
+# 1. Capture current versions before updating
+# This allows us to know what was working if the update bricks the system
+echo "Capturing current version state..."
+{
+    echo "--- Snapshot $(date) ---"
+    echo "System Packages:"
+    dpkg -l | grep -E 'opencode|openchamber' || echo "No specific packages found"
+    echo "Python Packages:"
+    pip list 2>/dev/null || echo "Pip not installed"
+    echo "Git Commits:"
+    # Assuming tools are in /opt/
+    for dir in /opt/opencode /opt/openchamber; do
+        if [ -d "$dir/.git" ]; then
+            echo "$dir: $(git -C "$dir" rev-parse HEAD)"
+        fi
+    done
+} > "$VERSION_SNAPSHOT"
+
+# 2. Run the Ansible maintenance playbook
+echo "Applying updates via Ansible..."
+ansible-playbook -i "$INVENTORY" "$ANSIBLE_PLAYBOOK" >> "$LOG_FILE" 2>&1
+
+if [ $? -eq 0 ]; then
+    echo "[$(date)] Update applied successfully." >> "$LOG_FILE"
+else
+    echo "[$(date)] UPDATE FAILED. Check logs for details." >> "$LOG_FILE"
+    # In a fully autonomous setup, we log the failure. 
+    # Since infra is scripted, the user can rebuild using the snapshot in $VERSION_SNAPSHOT.
+    exit 1
+fi
+
+# 3. Post-update health check (Example: checking if services are active)
+echo "Verifying service health..."
+SERVICES=("opencode" "openchamber")
+for svc in "${SERVICES[@]}"; do
+    if systemctl is-active --quiet "$svc"; then
+        echo "[$(date)] Service $svc is healthy." >> "$LOG_FILE"
+    else
+        echo "[$(date)] WARNING: Service $svc failed to start after update!" >> "$LOG_FILE"
+    fi
+done
+
+echo "[$(date)] Update sequence complete." >> "$LOG_FILE"
