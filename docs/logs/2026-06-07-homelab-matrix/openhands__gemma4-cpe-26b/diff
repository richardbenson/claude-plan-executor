+# Version manifest for tools installed on opencode VMs
+# This file serves as our "last known good" registry. 
+# To update all tools to their latest versions automatically via the update playbook, 
+# you would typically have a process that updates this file and commits it.
+
+# Node.js major version (uses Nodesource repository)
+nodejs_major_version: "22"
+
+# openchamber (GitHub release tgz)
+openchamber_version: "1.11.7"
+
+# GitHub CLI (binaries from GitHub releases)
+gh_cli_version: "2.93.0"
+
+# Tea CLI (Gitea binaries)
+tea_cli_version: "0.14.1"
+
+# RTK (GitHub release tar.gz)
+rtk_version: "0.42.0"
