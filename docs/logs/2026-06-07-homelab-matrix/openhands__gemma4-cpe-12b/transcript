ironment:\n        DEBIAN_FRONTEND: noninteractive\n\n    # -- opencode -------------------------------------------------------------\n\n    - name: Install opencode globally via npm\n      ansible.builtin.shell:\n        cmd: npm install -g opencode-ai\n        creates: /usr/local/bin/opencode\n\n    # -- openchamber ----------------------------------------------------------\n\n    - name: Install openchamber via npm (GitHub release tgz)\n      ansible.builtin.shell:\n        cmd: >\n          npm install -g\n          https://github.com/openchamber/openchamber/releases/download/v1.11.7/openchamber-web-1.11.7.tgz\n        creates: /usr/local/bin/openchamber\n\n    # -- gh CLI ---------------------------------------------------------------\n\n    - name: Download gh CLI v2.93.0\n      ansible.builtin.unarchive:\n        src: https://github.com/cli/cli/releases/download/v2.93.0/gh_2.93.0_linux_amd64.tar.gz\n        dest: /tmp\n        remote_src: true\n        creates: /tmp/gh_2.93.0_linux_amd64\n\n    - name: Install gh binary\n      ansible.builtin.copy:\n        src: /tmp/gh_2.93.0_linux_amd64/bin/gh\n        dest: /usr/local/bin/gh\n        mode: \"0755\"\n        remote_src: true\n\n    # -- tea CLI --------------------------------------------------------------\n\n    - name: Install tea CLI v0.14.1\n      ansible.builtin.get_url:\n        url: https://gitea.com/gitea/tea/releases/download/v0.14.1/tea-0.14.1-linux-amd64\n        dest: /usr/local/bin/tea\n        mode: \"0755\"\n\n    # -- rtk ------------------------------------------------------------------\n\n    - name: Download rtk v0.42.0 (musl)\n      ansible.builtin.unarchive:\n        src: https://github.com/rtk-ai/rtk/releases/download/v0.42.0/rtk-x86_64-unknown-linux-musl.tar.gz\n        dest: /tmp\n        remote_src: true\n        creates: /tmp/rtk\n\n    - name: Install rtk binary\n      ansible.builtin.copy:\n        src: /tmp/rtk\n        dest: /usr/local/bin/rtk\n        mode: \"0755\"\n        remote_src: true\n\n    # -- opencode system user -------------------------------------------------\n\n    - name: Create opencode system user\n      ansible.builtin.user:\n        name: opencode\n        system: true\n        create_home: true\n        shell: /bin/bash\n\n    # -- bun (as opencode user) ------------------------------------------------\n\n    - name: Install bun as opencode user\n      ansible.builtin.shell:\n        cmd: curl -fsSL https://bun.sh/install | bash\n        creates: /home/opencode/.bun/bin/bun\n      become_user: opencode\n      environment:\n        HOME: /home/opencode\n\n    # -- opencode config -------------------------------------------------------\n\n    - name: Ensure opencode config directory exists\n      ansible.builtin.file:\n        path: /home/opencode/.config/opencode\n        state: directory\n        owner: opencode\n        group: opencode\n        mode: \"0755\"\n\n    - name: Template opencode.json\n      ansible.builtin.template:\n        src: ../templates/opencode.json.j2\n        dest: /home/opencode/.config/opencode/opencode.json\n        owner: opencode\n        group: opencode\n        mode: \"0644\"\n      notify: Reload systemd and restart openchamber\n\n    # -- RTK plugin ------------------------------------------------------------\n\n    - name: Initialize RTK opencode plugin\n      ansible.builtin.shell:\n        cmd: /usr/local/bin/rtk init -g --opencode\n        creates: /home/opencode/.config/opencode/plugins/rtk.ts\n      become_user: opencode\n      environment:\n        HOME: /home/opencode\n        PATH: /usr/local/bin:/usr/bin:/bin\n      async: 30\n      poll: 5\n\n    # -- Caveman plugin --------------------------------------------------------\n\n    - name: Install Caveman plugin\n      ansible.builtin.shell:\n        cmd: /home/opencode/.bun/bin/bunx github:JuliusBrussee/caveman --only opencode || true\n        creates: /home/opencode/.config/opencode/plugins/caveman\n      become_user: opencode\n      environment:\n        HOME: /home/opencode\n\n    # -- Caveman default mode --------------------------------------------------\n\n    - name: Ensure caveman config directory exists\n      ansible.builtin.file:\n        path: /home/opencode/.config/caveman\n        state: directory\n        owner: opencode\n        group: opencode\n        mode: \"0755\"\n\n    - name: Set caveman default mode to off (opt-in per session via /caveman)\n      ansible.builtin.copy:\n        content: '{\"defaultMode\":\"off\"}'\n        dest: /home/opencode/.config/caveman/config.json\n        owner: opencode\n        group: opencode\n        mode: \"0644\"\n\n    # -- VCS CLI authentication ------------------------------------------------\n\n    - name: Authenticate gh CLI\n      ansible.builtin.shell:\n        cmd: \"echo '{{ opencode_github_token }}' | gh auth login --with-token\"\n      become_user: opencode\n      environment:\n        HOME: /home/opencode\n        PATH: /usr/local/bin:/usr/bin:/bin\n      no_log: true\n      changed_when: true\n\n    - name: Authenticate tea CLI (Gitea)\n      ansible.builtin.shell:\n        cmd: |\n          tea login delete homelab 2>/dev/null || true\n          tea login add --name homelab \\\n            --url https://{{ opencode_gitea_hostname }} \\\n            --token \"{{ opencode_gitea_token }}\"\n      become_user: opencode\n      environment:\n        HOME: /home/opencode\n        PATH: /usr/local/bin:/usr/bin:/bin\n      no_log: true\n      changed_when: true\n\n    # -- Git credentials ------------------------------------------------------\n\n    - name: Template ~/.git-credentials\n      ansible.builtin.template:\n        src: ../templates/git-credentials.j2\n        dest: /home/opencode/.git-credentials\n        owner: opencode\n        group: opencode\n        mode: \"0600\"\n      no_log: true\n\n    - name: Configure git credential helper\n      community.general.git_config:\n        name: credential.helper\n        scope: global\n        value: store\n      become_user: opencode\n      environment:\n        HOME: /home/opencode\n\n    # -- openchamber systemd service -------------------------------------------\n\n    - name: Install openchamber systemd unit\n      ansible.builtin.template:\n        src: ../templates/openchamber.service.j2\n        dest: /etc/systemd/system/openchamber.service\n        owner: root\n        group: root\n        mode: \"0644\"\n      notify: Reload systemd and restart openchamber\n\n    - name: Enable and start openchamber service\n      ansible.builtin.systemd:\n        name: openchamber\n        enabled: true\n        state: started\n        daemon_reload: true",
