src/commands/update.ts
  @@ -0,0 +1,41 @@
  +import { CPE_VERSION } from '../version.js';
  +import { fetchLatestTag, isNewer } from '../update/check.js';
  +import { downloadAndInstall } from '../update/install.js';
  +import { writeUpdateState } from '../update/state.js';
  +
  +export async function updateCommand(opts: { check?: boolean }): Promise<void> {
  +  // For dev builds, self-update is disabled
  +  if (CPE_VERSION === 'dev') {
  +    console.log('Self-update is disabled for dev builds. Rebuild with `scripts/install-local.sh` to enable.');
  +    return;
  +  }
  +
  +  const latest = await fetchLatestTag();
  +
  +  if (opts.check) {
  +    // --check mode: just print version info and update status
  +    if (isNewer(latest, CPE_VERSION)) {
  +      console.log(`Current version: ${CPE_VERSION}`);
  +      console.log(`Latest tag: ${latest}`);
  +      console.log('Update available — run cpe update');
  +    } else {
  +      console.log(`Current version: ${CPE_VERSION}`);
  +      console.log(`Latest tag: ${latest}`);
  +      console.log('Already up to date');
  +    }
  +    return;
  +  }
  +
  +  // Normal mode: check if update is needed and install if so
  +  if (isNewer(latest, CPE_VERSION)) {
  +    console.log(`Downloading cpe ${latest}... (this may take a moment)`);
  +    await downloadAndInstall(latest);
  +    console.log(`Updated ${CPE_VERSION} → ${latest}`);
  +    console.log('Note: any running `cpe start` session is still on the old version and should be restarted.');
  +  } else {
  +    console.log(`Already up to date (${CPE_VERSION})`);
  +  }
  +
  +  // Record the update check so the nudge throttle resets
  +  writeUpdateState({ last_checked_at: new Date().toISOString(), latest_seen: latest });
  +}
