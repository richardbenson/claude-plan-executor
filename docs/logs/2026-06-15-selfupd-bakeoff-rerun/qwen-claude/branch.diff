scripts/install.sh
  @@ -24,6 +24,42 @@ echo "Downloading ${ASSET}..."
  +
  +# Verify checksum if available
  +checksum_cmd=""
  +if command -v sha256sum >/dev/null 2>&1; then
  +  checksum_cmd="sha256sum"
  +elif command -v shasum >/dev/null 2>&1; then
  +  checksum_cmd="shasum -a 256"
  +else
  +  echo "[warn] No SHA256 checksum utility found. Verification skipped." >&2
  +fi
  +
  +if [[ -n "$checksum_cmd" ]]; then
  +  # Download SHA256SUMS file
  +  temp_sumfile=$(mktemp)
  +  if curl -fsSL "https://github.com/richardbenson/claude-plan-executor/releases/latest/download/SHA256SUMS" -o "$temp_sumfile"; then
  +    # Extract the expected hash for our asset
  +    expected_hash=$(awk -v asset="$ASSET" '$0 ~ asset {print $1}' "$temp_sumfile")
  +    if [[ -n "$expected_hash" ]]; then
  +      # Calculate actual hash
  +      actual_hash=$($checksum_cmd "$HOME/.local/bin/cpe" | awk '{print $1}')
  +      if [[ "$actual_hash" != "$expected_hash" ]]; then
  +        rm -f "$HOME/.local/bin/cpe"
  +        echo "[error] Checksum mismatch for downloaded binary." >&2
  +        echo "        Expected: $expected_hash" >&2
  +        echo "        Actual:   $actual_hash" >&2
  +        exit 1
  +      fi
  +    else
  +      echo "[warn] No checksum found for $ASSET in SHA256SUMS. Verification skipped." >&2
  +    fi
  +  else
  +    echo "[warn] SHA256SUMS not found. Verification skipped (old release)." >&2
  +  fi
  +  rm -f "$temp_sumfile"
  +fi
  +
   chmod +x "$HOME/.local/bin/cpe"
   
   echo "Installed: $HOME/.local/bin/cpe"
