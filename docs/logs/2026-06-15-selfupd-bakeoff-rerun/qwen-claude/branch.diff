  +import { useState, useEffect } from 'react';
  +import { getInstalledUpdate, subscribeInstalledUpdate } from '../../update/auto.ts';
  +
  +export function useInstalledUpdate(): string | null {
  +  const [update, setUpdate] = useState<string | null>(getInstalledUpdate());
  +
  +  useEffect(() => {
  +    const unsubscribe = subscribeInstalledUpdate((tag) => {
  +      setUpdate(tag);
  +    });
  +
  +    return unsubscribe;
  +  }, []);
  +
  +  return update;
  +}
